{ f: 80, l: 1/4, g: 1, p: 0 }

kick = {
    Kick {
        pitch_decay: 0.05,
        pitch_range: 4.0,
        amp_decay: 0.45,
        click_amount: 0.25,
        click_freq: 2000,
        saturation: 0.30,
        velocity_tilt: 0.7
    } | Gm 0.5
}

ghost_kick = {
    Kick {
        pitch_decay: 0.04,
        pitch_range: 3.0,
        amp_decay: 0.30,
        click_amount: 0.10,
        click_freq: 1500,
        saturation: 0.18,
        velocity_tilt: 0.8
    }
    | Gm 0.25
}

snare = {
    Snare {
        shell_decay: 0.08,
        wire_decay: 0.05,
        wire_mix: 0.5,
        shell_pitch_decay: 40,
        shell_pitch_range: 0.3,
        crack: 0.9,
        attack_amount: 0.5,
        saturation: 0.25,
        velocity_tilt: 0.6
    }
    | Fm 2
}

ghost_snare = {
    Snare {
        shell_decay: 0.08,
        wire_decay: 0.05,
        wire_mix: 0.6,
        shell_pitch_range: 0.15,
        crack: 0.4,
        attack_amount: 0.3,
        saturation: 0.1,
        velocity_tilt: 0.8
    }
    | Fm 2.5
    | Gm 0.55
}

hat = {
    HiHat {
        decay_rate: 25,
        brightness: 0.9,
        pitch_drop: 0.015,
        velocity_tilt: 0.4
    }
    | Fm 75
    | Gm 0.2
}

hat_accent = {
    HiHat {
        decay_rate: 30,
        brightness: 1.1,
        pitch_drop: 0.02,
        velocity_tilt: 0.5
    }
    | Fm 90
    | Gm 0.3
}

hat_soft = {
    HiHat {
        decay_rate: 35,
        brightness: 0.7,
        pitch_drop: 0.01,
        velocity_tilt: 0.6
    }
    | Fm 65
    | Gm 0.1
}

open_hat = {
    OpenHat {
        decay_rate: 8,
        brightness: 1.0,
        pitch_drop: 0.025,
        velocity_tilt: 0.4
    }
    | Fm 75
    | Gm 0.3
}

x = { Silence 1 }

s = { Lm 1/4 }

kick_pattern = {
    Seq [
        kick | s, x | s, x | s, x | s,
        x | s, x | s, ghost_kick | s, x | s,
        kick | s, x | s, x | s, kick | s,
        x | s, x | s, x | s, x | s
    ]
}

snare_pattern = {
    Seq [
        x | s, x | s, x | s, ghost_snare | s,
        snare | s, x | s, x | s, x | s,
        x | s, ghost_snare | s, x | s, x | s,
        snare | s, x | s, x | s, x | s
    ]
}

hat_pattern = {
    Seq [
        hat_accent | s, hat_soft | s, hat | s, hat_soft | s,
        hat | s, hat_soft | s, hat | s, hat_soft | s,
        hat_accent | s, hat_soft | s, hat | s, hat_soft | s,
        hat | s, hat_soft | s, open_hat | s, x | s
    ]
}

bar = {
    Overlay [
        kick_pattern,
        snare_pattern,
        hat_pattern
    ]
}

kick_pattern_v2 = {
    Seq [
        kick | s, x | s, ghost_kick | s, x | s,
        x | s, ghost_kick | s, x | s, x | s,
        kick | s, x | s, x | s, kick | s,
        ghost_kick | s, x | s, kick | s, x | s
    ]
}

bar_v2 = {
    Overlay [
        kick_pattern_v2,
        snare_pattern,
        hat_pattern
    ]
}

snare_fill = {
    Seq [
        x | s, x | s, x | s, x | s,
        snare | s, x | s, ghost_snare | s, ghost_snare | s,
        snare | s, ghost_snare | s, snare | s, ghost_snare | s,
        snare | s, snare | s, snare | Gm 1.2 | s, snare | Gm 1.3 | s
    ]
}

fill_bar = {
    Overlay [
        kick_pattern,
        snare_fill,
        hat_pattern
    ]
}

drums = {
    Seq [
        bar,
        bar,
        bar_v2,
        bar,
        bar,
        bar_v2,
        bar,
        fill_bar
    ]
    | Color [white, lightgray, gray]
    | wgsl {
        Direction(0, 0, -1);
    }
}

chords = {
    Overlay [
        { 3/2, 3, 1, 1/5 },
        { 3/2, 0, 1, -1/5 },
        { 1, 0.2, 1, 1/6 },
        { 1, 3, 1, 1/6 },
        { 3/4, 3, 1, 1/5 },
        { 3/4, 0, 1, -1/5 },
        { 1/2, 0.2, 1, 1/6 },
        { 1/2, 0, 1, -1/6 },
        { 1/4, 3, 1, 1/6 },
        { 1/4, 0, 1, -1/6 },
    ]
    -- | Seq [
    -- Fm 1, Fm 0, Fm 0, Fa -5,
    -- ]
    -- | Repeat 2
    | Seq [
        Fm 0, Fm 1 | Lm 2, Fm 9/8, Fm 0, Fm 3/4, Fm 2/3, Fm 5/8, Fm 7/12 | Lm 1/8,
    ]
    | Overlay [
        Sine 3/2 | Gm 1/4,
        Square | Gm 1/4,
        Sine,
    ]
    | Gm 1/2
    | Repeat 4
    | FitLength drums
    | wgsl {
        Direction(0, 0, -1);
    }
    | FitLength drums
}

main = {
    Overlay [
        drums,
        chords
    ]
    | Repeat 2
    | Lm 1.7
    | Overlay [
        Gm 2,
    ]
}

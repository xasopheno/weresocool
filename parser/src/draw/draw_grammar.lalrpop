// Draw DSL grammar — port of `crates/kintaro/src/draw/parser.rs`. Output
// AST (`DrawPipeline`, `DrawOp`, `Anchor`, `Increment`, `Field`, `DrawExpr`,
// `BinOp`, `NoteField`, `Axis`) is unchanged so every shipped composition
// keeps parsing and rendering bit-identically.
//
// Pre-processing notes (handled by `grammar_helpers::preprocess`):
//   * `τ` (U+03C4) is replaced with the ASCII identifier `tau`.

use crate::draw::ast::{
    DrawPipeline, DrawOp, DrawExpr, BinOp, MathFn, Anchor, Increment, Field,
    Axis, NoteField, DrawPhase,
};
use crate::draw::grammar_helpers as h;

grammar;

match {
    "|", "(", ")", "{", "}", "[", "]", ",", ";", ":", "..", ".", "+", "-", "*", "/",

    // Generator + identity / mute
    "Point", "AsIs", "None",

    // Atoms / functions
    "Stroke", "Clock", "Mod", "Sin", "Tau", "Note", "Here",
    "Count", "Cycle", "Rand", "Choose", "Time",

    // Note field names (matched after `note .`)
    "x", "y", "z", "l", "t", "gain", "voice", "direction",

    // Ops
    "Xa", "Ya", "Xf", "Yf", "AtY", "Za", "Rx", "Ry", "Rz", "Sm", "Sa",
    "Direction", "Jitter", "Mirror", "Modulate", "Tint", "Gradient",
    "Warm", "Cool",
    "Lerp", "Spawn", "Echo", "Stagger", "Drag", "Each",
    "Every", "Sometimes", "Jux",
    "Seq", "Overlay", "Alt", "Lm", "FitLength", "Iterate",
    "Path", "Smooth", "Pin", "Pick",

    // Mirror axes (parsed as bare identifiers)
    "X", "Y", "Z",

    // Field constructors
    "Noise", "Flow", "Const",

    // Named-arg keys
    "to", "n", "dt", "decay", "over", "dv", "by",
    "axis", "scale", "seed", "freq",

    // Pure math functions (lowercase) — Law-4 set; see dsl_expr::MathFn.
    "sin", "cos", "abs", "floor", "ceil", "sqrt", "exp", "min", "max", "pow", "Wrap", "clamp", "mix",

    r"\s+"          => { },
    r"//[^\n]*"     => { },
    r"--[^\n]*"     => { },
} else {
    // Rational literal: `INT/INT` with NO surrounding whitespace folds to a
    // single number, matching the hand tokenizer (`9/8` → 1.125). Longest-
    // match beats `INT "/" INT`, and the missing-whitespace requirement means
    // `9 / 8` still tokenizes as a division op — identical to the hand parser.
    r"[0-9]+/[0-9]+"                    => RATIONAL,
    r"[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?" => FLOAT_LIT,
    r"[0-9]+([eE][+-]?[0-9]+)?"         => INT_LIT,
    r"[a-zA-Z_][a-zA-Z0-9_]*"           => IDENT,
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

pub Pipeline: DrawPipeline = {
    "Point" <ops:PipeTail> => DrawPipeline { ops },
    // `Path [ … ]` starts a pipeline with an explicit form.
    "Path" "[" <pts:PathPoints> "]" <ops:PipeTail> => {
        let mut v = vec![DrawOp::Path(pts)];
        v.extend(ops);
        DrawPipeline { ops: v }
    },
};

// A point list: `(x, y)` or `(x, y, z)`, comma-separated.
PathPoints: Vec<(DrawExpr, DrawExpr, DrawExpr)> = {
    <first:PathPoint> <rest:PathPointTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};
PathPointTail: Vec<(DrawExpr, DrawExpr, DrawExpr)> = {
    => vec![],
    "," <p:PathPoint> <rest:PathPointTail> => {
        let mut v = vec![p];
        v.extend(rest);
        v
    },
};
PathPoint: (DrawExpr, DrawExpr, DrawExpr) = {
    "(" <x:Expr> "," <y:Expr> ")" => (x, y, DrawExpr::Lit(0.0)),
    "(" <x:Expr> "," <y:Expr> "," <z:Expr> ")" => (x, y, z),
};

PipeTail: Vec<DrawOp> = {
    => vec![],
    "|" <op:Op> <rest:PipeTail> => {
        let mut v = vec![op];
        v.extend(rest);
        v
    },
};

// A generator-less chain of ops (`Xa(1) | Sm 2`) — the sub-pipeline for the
// higher-order combinators, which modify the EXISTING emit set rather than
// generating from a Point.
OpChain: Vec<DrawOp> = {
    <first:Op> <rest:PipeTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------
Op: DrawOp = {
    // Single-arg translations / rotations / scale
    "Xa" <e:BareOrParenArg> => DrawOp::Xa(e),
    // placement in canvas fractions: ±1 is an edge, whatever the frame
    "Xf" <e:BareOrParenArg> => DrawOp::Xf(e),
    "Yf" <e:BareOrParenArg> => DrawOp::Yf(e),
    "Ya" <e:BareOrParenArg> => DrawOp::Ya(e),
    "AtY" <e:BareOrParenArg> => DrawOp::AtY(e),
    "Za" <e:BareOrParenArg> => DrawOp::Za(e),
    "Rx" <e:BareOrParenArg> => DrawOp::Rx(e),
    "Ry" <e:BareOrParenArg> => DrawOp::Ry(e),
    "Rz" <e:BareOrParenArg> => DrawOp::Rz(e),
    "Sm" <e:BareOrParenArg> => DrawOp::Sm(e),
    "Sa" <e:BareOrParenArg> => DrawOp::Sa(e),
    "Jitter" <e:BareOrParenArg> => DrawOp::Jitter(e),

    // Form ops.
    "Smooth" <e:BareOrParenArg> => DrawOp::Smooth(e),
    "Pin" => DrawOp::Pin,
    "Pick" <e:BareOrParenArg> => DrawOp::Pick(e),

    "Direction" "(" <x:Expr> "," <y:Expr> "," <z:Expr> ")" =>
        DrawOp::Direction(x, y, z),

    "AsIs" => DrawOp::AsIs,
    "None" => DrawOp::Mute,

    // Length multiply — `| Lm N` stretches per-emit time_offsets by N.
    // Audio-aligned. Inside a Seq phase, a *trailing* `| Lm N` sets the
    // phase length (handled by SeqPhaseBody which peels it off); a
    // non-trailing `| Lm N` is this op and adjusts emit timing.
    "Lm" <e:BareOrParenArg> => DrawOp::Lm(e),

    // Mirror — brace-named or positional. Audio house style is positional.
    "Mirror" "{" "axis" ":" <a:AxisLit> "}" => DrawOp::Mirror(a),
    "Mirror" "(" <a:AxisLit> ")" => DrawOp::Mirror(a),

    "Modulate" "(" <f:FieldExpr> "," <e:Expr> ")" => DrawOp::Modulate(f, e),

    // Tint — per-emit color multiply. Optional 4th arg (alpha) defaults to 1.0.
    "Tint" "(" <r:Expr> "," <g:Expr> "," <b:Expr> ")" =>
        DrawOp::Tint { r, g, b, a: DrawExpr::DefaultLit(1.0) },
    "Tint" "(" <r:Expr> "," <g:Expr> "," <b:Expr> "," <a:Expr> ")" =>
        DrawOp::Tint { r, g, b, a },

    // Gradient — ramp the VOICE's palette across THIS FIGURE, along a
    // direction. Same word as the voice-chain `Gradient`, and the same idea:
    // a palette ramp along an axis. What differs is the DOMAIN, and the
    // domain is given by where it is written — in the voice chain the ramp
    // spans one stamp, here it spans the whole set of marks the note emits.
    // A bare `Gradient` takes the piece's `light` direction.
    "Gradient" "(" <x:Expr> "," <y:Expr> "," <z:Expr> ")" =>
        DrawOp::Gradient { x: Some(x), y: Some(y), z: Some(z) },
    "Gradient" => DrawOp::Gradient { x: None, y: None, z: None },

    // Warm / Cool — one axis, two directions. They are the same operation
    // (`Cool(t)` is exactly `Warm(-t)`) and would be one keyword if a draw
    // expression could be negative — literals are unsigned and there is no
    // unary minus, so `Warm(-0.3)` cannot be written. Two names is the
    // honest way to reach both ends of an axis this grammar can only walk
    // one way.
    "Warm" <e:BareOrParenArg> => DrawOp::Temperature { amount: e, warm: true },
    "Cool" <e:BareOrParenArg> => DrawOp::Temperature { amount: e, warm: false },

    // Lerp — named or positional. AnchorExpr's first-token set (Here, Xa,
    // Ya, Za, Direction, note) doesn't collide with the `to` keyword, so
    // LR(1) picks the right rule from the first token after `(`.
    "Lerp" "{" "to" ":" <a:AnchorExpr> "," "n" ":" <n:Expr> "}" =>
        DrawOp::Lerp { to: a, n },
    "Lerp" "(" <a:AnchorExpr> "," <n:Expr> ")" => DrawOp::Lerp { to: a, n },

    // Spawn — `by:` named form, or positional (the `by` keyword is just
    // a label here; the value is an IncrementExpr either way).
    "Spawn" "{" "n" ":" <n:Expr> "," "by" ":" <by:IncrementExpr> "}" =>
        DrawOp::Spawn { n, by },
    "Spawn" "(" <n:Expr> "," <by:IncrementExpr> ")" => DrawOp::Spawn { n, by },

    // Echo — brace-named (with optional decay) or positional.
    "Echo" "{" "n" ":" <n:Expr> "," "dt" ":" <dt:Expr> "}" =>
        DrawOp::Echo { n, dt, decay: None },
    "Echo" "{" "n" ":" <n:Expr> "," "dt" ":" <dt:Expr> "," "decay" ":" <d:Expr> "}" =>
        DrawOp::Echo { n, dt, decay: Some(d) },
    "Echo" "(" <n:Expr> "," <dt:Expr> ")" =>
        DrawOp::Echo { n, dt, decay: None },
    "Echo" "(" <n:Expr> "," <dt:Expr> "," <d:Expr> ")" =>
        DrawOp::Echo { n, dt, decay: Some(d) },

    // Stagger — brace-named or positional (single arg, both equivalent shapes).
    "Stagger" "{" "over" ":" <o:Expr> "}" => DrawOp::Stagger { over: o },
    "Stagger" "(" <o:Expr> ")" => DrawOp::Stagger { over: o },

    // Drag — brace-named or positional. AST field order: over, n, dv.
    "Drag" "{" "over" ":" <o:Expr> "," "n" ":" <n:Expr> "," "dv" ":" <dv:Expr> "}" =>
        DrawOp::Drag { over: o, n, dv },
    "Drag" "(" <o:Expr> "," <n:Expr> "," <dv:Expr> ")" =>
        DrawOp::Drag { over: o, n, dv },

    "Each" "(" <p:Pipeline> ")" => DrawOp::Each(Box::new(p)),

    // Higher-order combinators — conditionally apply a sub-chain of ops to the
    // current emit set (no leading generator; they transform, not create).
    "Every" "(" <n:Expr> "," <ops:OpChain> ")" =>
        DrawOp::Every(n, Box::new(DrawPipeline { ops })),
    "Sometimes" "(" <pr:Expr> "," <ops:OpChain> ")" =>
        DrawOp::Sometimes(pr, Box::new(DrawPipeline { ops })),
    "Jux" "(" <ops:OpChain> ")" =>
        DrawOp::Jux(Box::new(DrawPipeline { ops })),

    // Composition primitives — same shapes as warp Seq/Overlay.
    "Seq"     "[" <phases:SeqPhaseList>      "]" => DrawOp::Seq { phases },
    "Overlay" "[" <layers:OverlayLayerList>  "]" => DrawOp::Overlay { layers },
    "Alt"     "[" <branches:OverlayLayerList> "]" => DrawOp::Alt { branches },
    "FitLength" <name:Name>                       => DrawOp::FitLength(name),
    // `Iterate n { ops }` — same spelling as warp's.
    "Iterate" <n:Factor> "{" <ops:OpChain> "}"    => DrawOp::Iterate { n, ops },
};

// ---------------------------------------------------------------------------
// Seq / Overlay bodies — mirror the shape of `warp/warp_grammar.lalrpop`
// ---------------------------------------------------------------------------
SeqPhaseList: Vec<DrawPhase> = {
    => vec![],
    <first:SeqPhaseItem> <rest:SeqPhaseTailItems> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};
SeqPhaseTailItems: Vec<DrawPhase> = {
    => vec![],
    SeqSep => vec![],
    SeqSep <p:SeqPhaseItem> <rest:SeqPhaseTailItems> => {
        let mut v = vec![p];
        v.extend(rest);
        v
    },
};
SeqSep: () = { "," => (), ";" => () };
/// A Seq phase: 1+ ops chained with `|`. The trailing `Lm` (if any) is
/// peeled off in the action via `peel_trailing_lm` — `Lm` is a normal
/// `DrawOp::Lm` everywhere else, and the Seq just grabs its value as the
/// phase's length when it appears last. Default length = 1.0 if no
/// trailing Lm. Avoids the LR(1) conflict between "phase suffix Lm" and
/// "regular Lm op".
SeqPhaseItem: DrawPhase = {
    <first:Op> <rest:SeqPhaseChainTail> => {
        let mut ops = vec![first];
        ops.extend(rest);
        let (ops, length) = h::peel_trailing_lm(ops);
        DrawPhase { ops, length: length.unwrap_or(DrawExpr::Lit(1.0)) }
    },
};
SeqPhaseChainTail: Vec<DrawOp> = {
    => vec![],
    "|" <op:Op> <rest:SeqPhaseChainTail> => {
        let mut v = vec![op];
        v.extend(rest);
        v
    },
};

OverlayLayerList: Vec<Vec<DrawOp>> = {
    => vec![],
    <first:OverlayLayer> <rest:OverlayTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};
OverlayTail: Vec<Vec<DrawOp>> = {
    => vec![],
    SeqSep => vec![],
    SeqSep <l:OverlayLayer> <rest:OverlayTail> => {
        let mut v = vec![l];
        v.extend(rest);
        v
    },
};
OverlayLayer: Vec<DrawOp> = {
    <first:Op> <rest:LayerTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};
LayerTail: Vec<DrawOp> = {
    => vec![],
    "|" <op:Op> <rest:LayerTail> => {
        let mut v = vec![op];
        v.extend(rest);
        v
    },
};

AxisLit: Axis = {
    "X" => Axis::X,
    "Y" => Axis::Y,
    "Z" => Axis::Z,
};

// ---------------------------------------------------------------------------
// Anchor — used by Lerp's `to:` arg
// ---------------------------------------------------------------------------
AnchorExpr: Anchor = {
    <l:AnchorExpr> "+" <r:AnchorTerm> => Anchor::Add(Box::new(l), Box::new(r)),
    <l:AnchorExpr> "-" <r:AnchorTerm> => Anchor::Sub(Box::new(l), Box::new(r)),
    <t:AnchorTerm> => t,
};
AnchorTerm: Anchor = {
    <a:AnchorAtom> "*" <e:Term> => h::scale_anchor(a, e),
    <a:AnchorAtom> => a,
};
AnchorAtom: Anchor = {
    "Here" => Anchor::Here,
    "Xa" "(" <e:Expr> ")" => Anchor::Xa(e),
    "Ya" "(" <e:Expr> ")" => Anchor::Ya(e),
    "Za" "(" <e:Expr> ")" => Anchor::Za(e),
    "Direction" "(" <x:Expr> "," <y:Expr> "," <z:Expr> ")" => Anchor::Direction(x, y, z),
    // `note.direction` is sugar for `Direction(note.x, note.y, note.z)`
    "Note" "." "direction" =>
        Anchor::Direction(
            DrawExpr::Note(NoteField::X),
            DrawExpr::Note(NoteField::Y),
            DrawExpr::Note(NoteField::Z),
        ),
    "(" <a:AnchorExpr> ")" => a,
};

// ---------------------------------------------------------------------------
// Increment — used by Spawn's `by:` arg
//
// Three accepted shapes (all collapse to a single `Increment`):
//   atom                       single op
//   ( atom, atom, ... )        tuple
//   atom | atom | ...          pipe chain (folded to Tuple)
// ---------------------------------------------------------------------------
IncrementExpr: Increment = {
    "(" <first:IncrementAtom> "," <rest:IncrementCommaList> ")" => {
        let mut v = vec![first];
        v.extend(rest);
        Increment::Tuple(v)
    },
    <first:IncrementAtom> <rest:IncrementPipeTail> => {
        let mut v = vec![first];
        v.extend(rest);
        h::fold_increment_chain(v)
    },
};
IncrementCommaList: Vec<Increment> = {
    <a:IncrementAtom> => vec![a],
    <a:IncrementAtom> "," <rest:IncrementCommaList> => {
        let mut v = vec![a];
        v.extend(rest);
        v
    },
};
IncrementPipeTail: Vec<Increment> = {
    => vec![],
    "|" <a:IncrementAtom> <rest:IncrementPipeTail> => {
        let mut v = vec![a];
        v.extend(rest);
        v
    },
};
IncrementAtom: Increment = {
    "Xa" <e:BareOrParenArg> => Increment::Xa(e),
    "Ya" <e:BareOrParenArg> => Increment::Ya(e),
    "Za" <e:BareOrParenArg> => Increment::Za(e),
    "Rx" <e:BareOrParenArg> => Increment::Rx(e),
    "Ry" <e:BareOrParenArg> => Increment::Ry(e),
    "Rz" <e:BareOrParenArg> => Increment::Rz(e),
    "Sm" <e:BareOrParenArg> => Increment::Sm(e),
    "Sa" <e:BareOrParenArg> => Increment::Sa(e),
    "Direction" "(" <x:Expr> "," <y:Expr> "," <z:Expr> ")" =>
        Increment::Direction(x, y, z),
};

// ---------------------------------------------------------------------------
// Field — used by Modulate's first arg
// ---------------------------------------------------------------------------
FieldExpr: Field = {
    "Sin" "(" <e:Expr> ")" => Field::Sin { freq: e },
    "Sin" "{" "freq" ":" <e:Expr> "}" => Field::Sin { freq: e },
    "Noise" "{" "scale" ":" <s:Expr> "}" => Field::Noise { scale: s, seed: None },
    "Noise" "{" "scale" ":" <s:Expr> "," "seed" ":" <d:Expr> "}" =>
        Field::Noise { scale: s, seed: Some(d) },
    "Flow" "{" "scale" ":" <s:Expr> "}" => Field::Flow { scale: s, seed: None },
    "Flow" "{" "scale" ":" <s:Expr> "," "seed" ":" <d:Expr> "}" =>
        Field::Flow { scale: s, seed: Some(d) },
    "Const" "(" <e:Expr> ")" => Field::Const(e),
    "Note" "." <n:NoteFieldName> => Field::Note(n),
};

// ---------------------------------------------------------------------------
// Expression grammar
// ---------------------------------------------------------------------------
pub Expr: DrawExpr = {
    <l:Expr> "+" <r:Term> => DrawExpr::Bin(BinOp::Add, Box::new(l), Box::new(r)),
    <l:Expr> "-" <r:Term> => DrawExpr::Bin(BinOp::Sub, Box::new(l), Box::new(r)),
    <t:Term> => t,
};
Term: DrawExpr = {
    <l:Term> "*" <r:Factor> => DrawExpr::Bin(BinOp::Mul, Box::new(l), Box::new(r)),
    <l:Term> "/" <r:Factor> => DrawExpr::Bin(BinOp::Div, Box::new(l), Box::new(r)),
    <f:Factor> => f,
};
Factor: DrawExpr = {
    <n:Num> => DrawExpr::Lit(n),
    "Stroke" => DrawExpr::Stroke,
    "Clock" => DrawExpr::Clock,
    // an element's own age — a stamp has one; a draw's marks do not
    "Time"  => DrawExpr::Age,
    "Mod" <name:Name> => DrawExpr::LoopName(name),
    "Tau"   => DrawExpr::Lit(std::f32::consts::TAU),
    "Sin" "(" <f:Expr> ")" =>
        DrawExpr::Sin { freq: Box::new(f), amp: Box::new(DrawExpr::DefaultLit(1.0)) },
    "Sin" "(" <f:Expr> "," <a:Expr> ")" =>
        DrawExpr::Sin { freq: Box::new(f), amp: Box::new(a) },
    <f:UnaryFn> "(" <a:Expr> ")" => DrawExpr::Call(f, vec![a]),
    <f:BinaryFn> "(" <a:Expr> "," <b:Expr> ")" => DrawExpr::Call(f, vec![a, b]),
    <f:TernaryFn> "(" <a:Expr> "," <b:Expr> "," <c:Expr> ")" => DrawExpr::Call(f, vec![a, b, c]),
    <f:VariadicFn> "(" <a:Expr> <rest:("," <Expr>)+> ")" =>
        rest.into_iter().fold(a, |acc, e| DrawExpr::Call(f, vec![acc, e])),
    "Note" "." <n:NoteFieldName> => DrawExpr::Note(n),
    // Law-4 note-index vocabulary:
    //   count       = the raw accumulating index (0,1,2,… unbounded)
    //   cycle(n)    = walk 0,1,… n-1, one per hit, repeat   (= cycle(0..n))
    //   cycle(a..b) = walk a, a+1, … b-1, one per hit, repeat
    //   cycle([…])  = walk an explicit list of values, repeat
    // cycle lowers onto wrap(count, …); count keeps growing (use for spirals).
    "Count" => DrawExpr::Note(NoteField::Event),
    "Cycle" "(" "[" <first:Expr> <rest:("," <Expr>)*> "]" ")" => {
        let mut vals = vec![first];
        vals.extend(rest);
        DrawExpr::Cycle(vals)
    },
    "Cycle" "(" <a:Expr> ".." <b:Expr> ")" => {
        let span = DrawExpr::Bin(BinOp::Sub, Box::new(b), Box::new(a.clone()));
        let wrapped = DrawExpr::Call(MathFn::Wrap,
            vec![DrawExpr::Note(NoteField::Event), span]);
        DrawExpr::Bin(BinOp::Add, Box::new(a), Box::new(wrapped))
    },
    "Cycle" "(" <n:Expr> ")" => DrawExpr::Call(MathFn::Wrap,
        vec![DrawExpr::Note(NoteField::Event), n]),
    // cycle(<name>) — 0→1 phase through a named audio cycle (time-sibling of
    // cycle(n)); resolved against the length env like `mod`.
    "Cycle" "(" <name:Name> ")" => DrawExpr::LoopPhase(name),
    // Randomness — deterministic per-note (hashed from count):
    "Rand" "(" <s:Expr> ")" => DrawExpr::Rand(Box::new(s)),
    "Choose" "(" "[" <first:Expr> <rest:("," <Expr>)*> "]" ")" => {
        let mut vals = vec![first];
        vals.extend(rest);
        DrawExpr::Choose(vals)
    },
    "(" <e:Expr> ")" => e,
    "-" <f:Factor>   =>
        DrawExpr::Bin(BinOp::Sub, Box::new(DrawExpr::DefaultLit(0.0)), Box::new(f)),
};

// Math-function names grouped by arity (see `dsl_expr::MathFn`).
UnaryFn: MathFn = {
    "sin" => MathFn::Sin, "cos" => MathFn::Cos, "abs" => MathFn::Abs,
    "floor" => MathFn::Floor, "ceil" => MathFn::Ceil, "sqrt" => MathFn::Sqrt,
    "exp" => MathFn::Exp,
};
BinaryFn: MathFn = { "pow" => MathFn::Pow, "Wrap" => MathFn::Wrap };
TernaryFn: MathFn = { "clamp" => MathFn::Clamp, "mix" => MathFn::Mix };
VariadicFn: MathFn = { "min" => MathFn::Min, "max" => MathFn::Max };

/// Bare-or-parenthesised scalar arg, matching the hand parser's accept-set
/// for ops like `Xa 0.05` / `Xa(0.05)`.
BareOrParenArg: DrawExpr = {
    "(" <e:Expr> ")" => e,
    <e:NonParenFactor> => e,
};
NonParenFactor: DrawExpr = {
    <n:Num> => DrawExpr::Lit(n),
    "Stroke" => DrawExpr::Stroke,
    "Clock" => DrawExpr::Clock,
    // an element's own age — a stamp has one; a draw's marks do not
    "Time"  => DrawExpr::Age,
    "Mod" <name:Name> => DrawExpr::LoopName(name),
    "Tau"   => DrawExpr::Lit(std::f32::consts::TAU),
    "Sin" "(" <f:Expr> ")" =>
        DrawExpr::Sin { freq: Box::new(f), amp: Box::new(DrawExpr::DefaultLit(1.0)) },
    "Sin" "(" <f:Expr> "," <a:Expr> ")" =>
        DrawExpr::Sin { freq: Box::new(f), amp: Box::new(a) },
    <f:UnaryFn> "(" <a:Expr> ")" => DrawExpr::Call(f, vec![a]),
    <f:BinaryFn> "(" <a:Expr> "," <b:Expr> ")" => DrawExpr::Call(f, vec![a, b]),
    <f:TernaryFn> "(" <a:Expr> "," <b:Expr> "," <c:Expr> ")" => DrawExpr::Call(f, vec![a, b, c]),
    <f:VariadicFn> "(" <a:Expr> <rest:("," <Expr>)+> ")" =>
        rest.into_iter().fold(a, |acc, e| DrawExpr::Call(f, vec![acc, e])),
    "Note" "." <n:NoteFieldName> => DrawExpr::Note(n),
    // count/cycle sugar — mirrors the Factor rules so bare op arguments accept it
    "Count" => DrawExpr::Note(NoteField::Event),
    "Cycle" "(" "[" <first:Expr> <rest:("," <Expr>)*> "]" ")" => {
        let mut vals = vec![first];
        vals.extend(rest);
        DrawExpr::Cycle(vals)
    },
    "Cycle" "(" <a:Expr> ".." <b:Expr> ")" => {
        let span = DrawExpr::Bin(BinOp::Sub, Box::new(b), Box::new(a.clone()));
        let wrapped = DrawExpr::Call(MathFn::Wrap,
            vec![DrawExpr::Note(NoteField::Event), span]);
        DrawExpr::Bin(BinOp::Add, Box::new(a), Box::new(wrapped))
    },
    "Cycle" "(" <n:Expr> ")" => DrawExpr::Call(MathFn::Wrap,
        vec![DrawExpr::Note(NoteField::Event), n]),
    // cycle(<name>) — 0→1 phase through a named audio cycle (time-sibling of
    // cycle(n)); resolved against the length env like `mod`.
    "Cycle" "(" <name:Name> ")" => DrawExpr::LoopPhase(name),
    "Rand" "(" <s:Expr> ")" => DrawExpr::Rand(Box::new(s)),
    "Choose" "(" "[" <first:Expr> <rest:("," <Expr>)*> "]" ")" => {
        let mut vals = vec![first];
        vals.extend(rest);
        DrawExpr::Choose(vals)
    },
    "-" <f:NonParenFactor> =>
        DrawExpr::Bin(BinOp::Sub, Box::new(DrawExpr::DefaultLit(0.0)), Box::new(f)),
};

NoteFieldName: NoteField = {
    "x"     => NoteField::X,
    "y"     => NoteField::Y,
    "z"     => NoteField::Z,
    "l"     => NoteField::L,
    "t"     => NoteField::T,
    // `gain` is what brush-wgsl has always called `z`. One field, one
    // meaning, two spellings — the alias keeps both working while the
    // grammar knows they are the same thing.
    "gain"  => NoteField::Z,
    "voice" => NoteField::Voice,
    // `note.event` (the index) is spelled `count` — see the count/cycle
    // sugar below, which lower onto NoteField::Event directly.
};

// Bare audio-op name (for `mod <name>`), mirrors warp's Name rule.
Name: String = { <s:IDENT> => s.to_string() };

Num: f32 = {
    <s:INT_LIT>   => s.parse().unwrap(),
    <s:FLOAT_LIT> => s.parse().unwrap(),
    <s:RATIONAL>  => h::parse_rational(s),
};

// WGSL DSL Grammar
// Compiles a DSL to WGSL code using VisualOp AST
//
// Position: Xm, Xa, Ym, Ya, Zm, Za (multiply/add)
// Scale: Sm, Sa
// Velocity: Vm, Va
// Length: Lm - duration in seconds
// Direction: Direction(x, y, z) - sets normalized direction vector
// Bend: Bend(bx, by, bz, k) - symmetric bulge toward vector (same start/end direction)
// Composition: A | B | C - compose operations
// Sequence: Seq [ A | Lm 1; B | Lm 2 ] - time-sequenced operations
//
// Examples:
//   Xm 2                       ->  x = x * 2.0;
//   Direction(0, -1, 0)        ->  direction = normalize(vec3<f32>(0.0, -1.0, 0.0)); velocity = 1.0;
//   Direction(0, -1, 0) | Vm 2 ->  direction = ...; velocity = 1.0; velocity = velocity * 2.0;
//   Direction(1, 0, 0) | Bend(0, 1, 0, 0.5) ->  cubic Bézier bulging upward (symmetric)
//   Seq [ Direction(0, -1, 0) | Lm 1; Direction(1, 0, 0) | Lm 1 ]
//                              ->  if (time < 1.0) { ... } else if (time < 2.0) { ... }

use num_rational::Rational64;
use weresocool_ast::wgsl::{VisualOp, WgslValue, float_to_rational};

grammar;

// Entry point - returns WGSL string
// Multiple semicolon-separated items run in parallel (each generates independent WGSL)
pub DslLine: String = {
    <items:(<Expr> ";")*> <last:Expr?> => {
        let mut all_items: Vec<VisualOp> = items;
        if let Some(l) = last {
            all_items.push(l);
        }
        all_items.iter()
            .map(|op| op.to_wgsl(0.0))
            .collect::<Vec<_>>()
            .join("\n")
    },
};

// Expression: composed operations separated by |
Expr: VisualOp = {
    <first:Term> <rest:("|" <Term>)*> => {
        rest.into_iter().fold(first, |acc, m| acc.compose(m))
    },
};

// Term: base operation, Seq, or raw WGSL
Term: VisualOp = {
    <op:BaseOp> => op,
    <seq:SeqExpr> => seq,
    <raw:RawWgsl> => VisualOp::Raw { wgsl: raw },
};

// Raw WGSL: anything that looks like an assignment or function call
// Must not start with a DSL keyword
// Note: [^;|]+ stops at semicolon or pipe (so pipes can be used with DSL commands)
RawWgsl: String = {
    // Assignment: identifier = expression (stops at ; or | for pipe composition)
    <s:r"[a-zA-Z_][a-zA-Z0-9_]*\s*=\s*[^;|]+"> => s.to_string(),
    // Function call: identifier(...) — lowercase start (host fns); uppercase
    // + parens are op keywords.
    <s:r"[a-z_][a-zA-Z0-9_]*\s*\([^)]*\)"> => s.to_string(),
};

// Base operations (create Simple variant)
// All commands now accept WgslVal which can be either a literal or a WGSL expression
BaseOp: VisualOp = {
    "Direction" "(" <x:WgslVal> "," <y:WgslVal> "," <z:WgslVal> ")" =>
        VisualOp::direction(x, y, z),
    "Bend" "(" <bx:WgslVal> "," <by:WgslVal> "," <bz:WgslVal> "," <k:WgslVal> ")" =>
        VisualOp::bend(bx, by, bz, k),
    "Xm" <v:WgslVal> => VisualOp::xm(v),
    "Xa" <v:WgslVal> => VisualOp::xa(v),
    "Ym" <v:WgslVal> => VisualOp::ym(v),
    "Ya" <v:WgslVal> => VisualOp::ya(v),
    "Zm" <v:WgslVal> => VisualOp::zm(v),
    "Za" <v:WgslVal> => VisualOp::za(v),
    "Sm" <v:WgslVal> => VisualOp::sm(v),
    "Sa" <v:WgslVal> => VisualOp::sa(v),
    "Smx" <v:WgslVal> => VisualOp::smx(v),
    "Smy" <v:WgslVal> => VisualOp::smy(v),
    "Smz" <v:WgslVal> => VisualOp::smz(v),
    "Vm" <v:WgslVal> => VisualOp::vm(v),
    "Va" <v:WgslVal> => VisualOp::va(v),
    "Lm" <v:WgslVal> => VisualOp::lm(v),
    "Bm" <v:WgslVal> => VisualOp::bm(v),
    "Ba" <v:WgslVal> => VisualOp::ba(v),
    "Die" <v:WgslVal> => VisualOp::die(v),
    "AsIs" => VisualOp::AsIs,
    // Source keyword `None` → AST variant `Mute` (renamed to avoid
    // shadowing `Option::None` in lalrpop-generated parser code).
    "None" => VisualOp::Mute,
    "Rx" <v:WgslVal> => VisualOp::rx(v),
    "Ry" <v:WgslVal> => VisualOp::ry(v),
    "Rz" <v:WgslVal> => VisualOp::rz(v),
};

// Seq expression (contains comma-separated expressions)
SeqExpr: VisualOp = {
    "Seq" "[" <items:SeqItems> "]" =>
        VisualOp::Seq { items },
};

// Items inside a Seq - comma or semicolon separated, with optional trailing separator
SeqItems: Vec<VisualOp> = {
    <v:(<Expr> SeqSep)*> <e:Expr?> => match e {
        None => v,
        Some(e) => {
            let mut v = v;
            v.push(e);
            v
        }
    },
};

// Separator for Seq items — comma (matches warp/draw Seq) or semicolon.
// `;` stays valid because it's also WGSL's real statement terminator; `,` is
// the "one language" spelling shared with every other DSL's Seq.
SeqSep: () = {
    "," => (),
    ";" => (),
};

// Parse WGSL values: either a compile-time rational or a runtime expression
// Expressions include: identifiers (time, x), function calls (sin(time)), binary ops (time * 2)
// Quoted strings are a fallback for edge cases (number-first, nested parens, commas)
WgslVal: WgslValue = {
    <e:SlewExpr> => WgslValue::Expr(e),
    // `mod <name>` — loop the live clock over a named audio length. The seconds
    // aren't known at weresocool parse time (they come from kintaro's cross-DSL
    // length env), so emit `wrap(song_time, 1.0/*@klen:NAME@*/)`: a naga-valid
    // expression carrying the name in a comment. Kintaro patches the `1.0`
    // literal to the resolved period after building its length env.
    "Mod" <name:r"[a-zA-Z_][a-zA-Z0-9_]+"> =>
        WgslValue::Expr(format!("wrap(song_time, 1.0/*@klen:{}@*/)", name)),
    <r:RatioValue> => WgslValue::Rational(r),
    <e:WgslExpr> => WgslValue::Expr(e),
    <s:QuotedStr> => WgslValue::Expr(s),
};

// Slew(target, rate) → starts at 1.0, exponentially relaxes toward `target`
// at the given rate. Expands to:
//     (target + exp(-time * rate) * (1.0 - target))
//
// Math: first-order low-pass response to a step input. Same shape as
//   • modular-synth "slew limiter" (Doepfer A-170, Make Noise Maths)
//   • SuperCollider `Lag.kr`
//   • Unity `Mathf.SmoothDamp`
//   • easings.net `easeOutExpo`
//
// Canonical use is the brush attack envelope `Bm Slew(0.18, 4)` — brightness
// pops bright at attack (1.0) and slews toward 0.18 sustain at rate 4.
SlewExpr: String = {
    "Slew" "(" <t:RatioValue> "," <r:RatioValue> ")" => {
        let t_f = (*t.numer() as f64) / (*t.denom() as f64);
        let r_f = (*r.numer() as f64) / (*r.denom() as f64);
        format!("({:.6} + exp(-time * {:.6}) * (1.0 - {:.6}))", t_f, r_f, t_f)
    },
};

// Quoted string: anything in double quotes passes through as WGSL expression
// Use for: "2 * time", "sin(cos(x))", "max(a, b)", "-time"
QuotedStr: String = {
    <s:r#""[^"]*""#> => s[1..s.len()-1].to_string(),
};

// WGSL expression: identifier, function call, or compound expression
// Matches things like: sin(time), time * x * 2, x + y, etc.
// Must start with a letter (not a digit) to distinguish from literals
// A leading identifier may carry ONE dotted field — `note.t`, `note.gain` —
// the Law-4 note.* surface. The wgsl_dsl.rs passthrough rewrites those dotted
// names (and `clock`) to the raw instance-struct fields naga sees.
WgslExpr: String = {
    // Function call: identifier(args) — LOWERCASE start only (host fns like
    // sin/cos). Uppercase-with-parens are OP keywords (Direction, Slew, Sin)
    // and must lex as keywords, not swallowed by this terminal. Uppercase
    // language fns (Cycle/Rand/Choose/Wrap) ride the QUOTED-expr path.
    <s:r"[a-z_][a-zA-Z0-9_]*\s*\([^)]*\)"> => s.to_string(),
    // Binary expression: identifier followed by operators and operands
    // Matches: time * 2, note.gain * 0.5, x + y * z, progress * 0.5
    <s:r"[a-zA-Z_][a-zA-Z0-9_]*(\.[a-zA-Z0-9_]+)?(\s*[\+\-\*\/]\s*[a-zA-Z0-9_\.]+)+"> => s.to_string(),
    // Simple identifier: time, progress, etc. (at least 2 chars to avoid single-letter numbers being captured)
    <s:r"[a-zA-Z_][a-zA-Z0-9_]+"> => s.to_string(),
    // Dotted note field: note.t, note.gain — the Law-4 note.* surface (rewritten
    // to the flat instance field downstream). A separate terminal from the plain
    // identifier (it always carries a `.`) to avoid lexer ambiguity.
    <s:r"[a-zA-Z_][a-zA-Z0-9_]*\.[a-zA-Z0-9_]+"> => s.to_string(),
};

// Parse rational values: 1/2, 0.5, 2, -1
RatioValue: Rational64 = {
    <n:Int> "/" <d:Int> => Rational64::new(n, d),
    <f:Float> => float_to_rational(f),
    <n:Int> => Rational64::new(n, 1),
};

Float: f64 = {
    <s:r"-?[0-9]+\.[0-9]*"> => s.parse().unwrap(),
};

Int: i64 = {
    <s:r"-?[0-9]+"> => s.parse().unwrap(),
};

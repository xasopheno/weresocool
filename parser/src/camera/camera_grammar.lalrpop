// Camera DSL grammar — the body of `camera NAME = { … }`.
//
// A brace bag (DSL_STYLE Law 6): order-free `key: value` terms, comma
// separated. Values are the shared `dsl_expr::Expr` (Law 4) restricted to the
// atoms a camera can have: numbers, arithmetic, `clock`, and the pure math
// functions — the same restriction `light` uses, and for the same reason. No
// `note.*`: a camera does not belong to a note.
//
// `move:` carries the timeline, whose phases mirror `Seq [ a | Lm 3, b | Lm 1 ]`
// everywhere else in the language.

use crate::dsl_expr::{Expr, BinOp, MathFn};
use crate::camera::ast::{CameraField, Move, MovePhase};
use std::str::FromStr;

grammar;

match {
    "(", ")", "{", "}", "[", "]", ",", ":", "|", "+", "-", "*", "/",
    "from", "look", "up", "fov", "move",
    "Seq", "Lm", "FitLength",
    "Dolly", "Truck", "Pedestal", "Pan", "Tilt", "Roll", "Orbit", "Zoom", "Hold",
    "by", "turns", "to",
    "clock", "Sin",
    "sin", "cos", "abs", "floor", "ceil", "sqrt", "exp",
    "min", "max", "pow", "wrap", "clamp", "mix", "step", "smoothstep",

    r"\s+"      => { },
    r"//[^\n]*" => { },
    r"--[^\n]*" => { },
} else {
    r"[0-9]+/[0-9]+"                    => RATIONAL,
    r"[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?" => FLOAT_LIT,
    r"[0-9]+([eE][+-]?[0-9]+)?"         => INT_LIT,
    r"[a-zA-Z_][a-zA-Z0-9_]*"           => IDENT,
}

/// The whole body: zero or more fields, trailing comma allowed.
pub Fields: Vec<CameraField> = {
    => Vec::new(),
    <first:Field> <rest:("," <Field>)*> ","? => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};

Field: CameraField = {
    // Where it stands, what it points at, which way is up. Three parts each,
    // so parenthesised — the same shape `light`'s `from:` uses.
    "from" ":" "(" <x:Expr> "," <y:Expr> "," <z:Expr> ")" => CameraField::From(x, y, z),
    "look" ":" "(" <x:Expr> "," <y:Expr> "," <z:Expr> ")" => CameraField::Look(x, y, z),
    "up"   ":" "(" <x:Expr> "," <y:Expr> "," <z:Expr> ")" => CameraField::Up(x, y, z),
    // Vertical field of view, in degrees. Bevy's perspective FOV is vertical
    // and the horizontal follows the target's aspect, which is why a piece
    // frames differently in a window than in a 16:9 export.
    "fov"  ":" <v:Expr> => CameraField::Fov(v),
    // The timeline.
    "move" ":" "Seq" "[" <ps:PhaseList> "]" <fit:FitTail?> =>
        CameraField::Moves(ps, fit),
};

/// `| FitLength name` — stretch the whole timeline onto that def's length.
FitTail: String = {
    "|" "FitLength" <n:IDENT> => n.to_string(),
};

PhaseList: Vec<MovePhase> = {
    => Vec::new(),
    <first:Phase> <rest:("," <Phase>)*> ","? => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};

/// One phase: the moves that run together, then optionally how long they take.
/// `Lm` last, exactly like a warp `Seq` phase; absent it defaults to 1.
Phase: MovePhase = {
    <first:Move> <rest:("|" <Move>)*> <len:("|" "Lm" <Expr>)?> => {
        let mut moves = vec![first];
        moves.extend(rest);
        MovePhase { moves, length: len.unwrap_or(Expr::DefaultLit(1.0)) }
    },
};

/// Each verb takes one argument, brace-named or positional. The brace form
/// reads better in a long timeline; the positional form is shorter when the
/// move is obvious.
Move: Move = {
    "Dolly"    "{" "by" ":" <e:Expr> "}" => Move::Dolly(e),
    "Dolly"    "(" <e:Expr> ")"          => Move::Dolly(e),
    "Truck"    "{" "by" ":" <e:Expr> "}" => Move::Truck(e),
    "Truck"    "(" <e:Expr> ")"          => Move::Truck(e),
    "Pedestal" "{" "by" ":" <e:Expr> "}" => Move::Pedestal(e),
    "Pedestal" "(" <e:Expr> ")"          => Move::Pedestal(e),
    "Pan"      "{" "by" ":" <e:Expr> "}" => Move::Pan(e),
    "Pan"      "(" <e:Expr> ")"          => Move::Pan(e),
    "Tilt"     "{" "by" ":" <e:Expr> "}" => Move::Tilt(e),
    "Tilt"     "(" <e:Expr> ")"          => Move::Tilt(e),
    "Roll"     "{" "by" ":" <e:Expr> "}" => Move::Roll(e),
    "Roll"     "(" <e:Expr> ")"          => Move::Roll(e),
    // `turns`, not `by`, because an orbit is measured in how far round it got.
    "Orbit"    "{" "turns" ":" <e:Expr> "}" => Move::Orbit(e),
    "Orbit"    "(" <e:Expr> ")"             => Move::Orbit(e),
    // `to`, not `by`: a zoom names the field of view it arrives at.
    "Zoom"     "{" "to" ":" <e:Expr> "}" => Move::Zoom(e),
    "Zoom"     "(" <e:Expr> ")"          => Move::Zoom(e),
    "Hold" => Move::Hold,
};

// --------------------------------------------------------------- expressions
// Identical to `light_grammar`'s, deliberately: one expression sublanguage
// across the declarative DSLs is the whole point of `dsl_expr`.

Expr: Expr = {
    <l:Expr> "+" <r:Term> => Expr::Bin(BinOp::Add, Box::new(l), Box::new(r)),
    <l:Expr> "-" <r:Term> => Expr::Bin(BinOp::Sub, Box::new(l), Box::new(r)),
    <t:Term> => t,
};

Term: Expr = {
    <l:Term> "*" <r:Factor> => Expr::Bin(BinOp::Mul, Box::new(l), Box::new(r)),
    <l:Term> "/" <r:Factor> => Expr::Bin(BinOp::Div, Box::new(l), Box::new(r)),
    <f:Factor> => f,
};

Factor: Expr = {
    <n:Num> => Expr::Lit(n),
    "clock" => Expr::Clock,
    "Sin" "(" <f:Expr> ")" =>
        Expr::Sin { freq: Box::new(f), amp: Box::new(Expr::DefaultLit(1.0)) },
    "Sin" "(" <f:Expr> "," <a:Expr> ")" =>
        Expr::Sin { freq: Box::new(f), amp: Box::new(a) },
    <f:UnaryFn> "(" <a:Expr> ")" => Expr::Call(f, vec![a]),
    <f:BinaryFn> "(" <a:Expr> "," <b:Expr> ")" => Expr::Call(f, vec![a, b]),
    <f:TernaryFn> "(" <a:Expr> "," <b:Expr> "," <c:Expr> ")" => Expr::Call(f, vec![a, b, c]),
    <f:VariadicFn> "(" <a:Expr> <rest:("," <Expr>)+> ")" =>
        rest.into_iter().fold(a, |acc, e| Expr::Call(f, vec![acc, e])),
    "(" <e:Expr> ")" => e,
    // Unary minus is the only way to write a negative — the number regexes
    // match unsigned digits, so `1-1` and `1 - 1` tokenise identically.
    "-" <f:Factor> => Expr::Bin(BinOp::Sub, Box::new(Expr::DefaultLit(0.0)), Box::new(f)),
};

UnaryFn: MathFn = {
    "sin" => MathFn::Sin, "cos" => MathFn::Cos, "abs" => MathFn::Abs,
    "floor" => MathFn::Floor, "ceil" => MathFn::Ceil,
    "sqrt" => MathFn::Sqrt, "exp" => MathFn::Exp,
};
BinaryFn: MathFn = { "pow" => MathFn::Pow, "wrap" => MathFn::Wrap, "step" => MathFn::Step };
TernaryFn: MathFn = { "clamp" => MathFn::Clamp, "mix" => MathFn::Mix, "smoothstep" => MathFn::Smoothstep };
VariadicFn: MathFn = { "min" => MathFn::Min, "max" => MathFn::Max };

Num: f32 = {
    <s:INT_LIT>   => f32::from_str(s).unwrap(),
    <s:FLOAT_LIT> => f32::from_str(s).unwrap(),
    <s:RATIONAL>  => {
        let (n, d) = s.split_once('/').unwrap();
        f32::from_str(n).unwrap() / f32::from_str(d).unwrap()
    },
};

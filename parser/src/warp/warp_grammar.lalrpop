// Warp DSL grammar — port of the hand-written recursive-descent parser at
// `crates/kintaro/src/warp/parser.rs`. The output AST (`WarpPipeline`,
// `WarpOp`, `Source`, `WarpExpr`, `SeqPhase`, `BinOp`) is unchanged so that
// every existing cull_*.socool composition keeps parsing and rendering
// bit-identically.
//
// Style notes
// -----------
//  * All ambiguous "bare-or-parenthesised scalar" forms are handled by a
//    single `BareOrParenArg` non-terminal whose body is restricted to a
//    *non-parenthesised* expression so it never conflicts with explicit
//    parens used elsewhere (`Background(top: (1,0,0))`).
//  * Order-independent named args are parsed flat as
//    `Vec<(String, WarpExpr)>` and resolved into the AST by helpers in
//    `grammar_helpers.rs`.
//  * Mixed-shape named args (Background's tuple-or-scalar) are tagged with
//    `BgArgVal` from `grammar_helpers`.
//
// Expression precedence: standard left-recursive `+/- < * / < unary-`.
// The unary minus is the ONLY way to write negative literals; the number
// regex matches unsigned digits only so that `5-5` and `5 - 5` tokenise
// identically.

use crate::warp::ast;
use crate::warp::ast::{
    WarpPipeline, WarpOp, WarpExpr, BinOp, MathFn, Source, SeqPhase, HitRef,
};
use crate::warp::grammar_helpers as h;
use crate::warp::grammar_helpers::BgArgVal;

grammar;

// ---------------------------------------------------------------------------
// Tokenizer — explicit keyword set so they take priority over IDENT; plus
// regex tokens for numbers, identifiers, and backtick-delimited raw WGSL.
// Whitespace and `// … / -- …` line comments are silently skipped.
// ---------------------------------------------------------------------------
match {
    "|", "(", ")", "{", "}", "[", "]", ",", ";", ":", "+", "-", "*", "/",

    "Prev", "Scene", "Volume", "Raymarch", "Osc", "Noise", "Gradient", "Solid",
    "time", "clock", "Sin", "Hit", "HitX", "HitY", "Dist", "HitAge", "Displace", "Ripple", "Glow", "Stir", "Bulge", "Relief", "Stain", "Watercolor",

    "Scale", "Rotate", "Scroll", "Swirl", "Fold", "Kaleid",
    "ChromaShift", "CurlFlow", "Wave", "Iterate",

    "Decay", "Hue", "Gamma", "Knee", "Gain", "Palette", "Blur",
    "Vignette", "Posterize", "Tint", "Bloom",
    "Background", "Clear", "Fade",

    "DepthVis", "Opaque", "Persist",

    "AsIs", "None",
    "Seq", "Overlay", "Lm", "FitLength",
    "Max", "Add", "Screen", "Mix", "Modulate",
    "Raw",

    // Substance verbs (MEDIUM.md M1) + their structural keywords.
    "Diffuse", "Advect", "Force", "Deposit", "Propagate", "Flow", "Set", "state", "grad", "lap", "by", "from", "gated",

    // Pure math functions (lowercase — distinct from the capitalized ops/
    // compositors like `Max`/`Mix`). Law-4 function set; see `dsl_expr::MathFn`.
    "sin", "cos", "abs", "floor", "ceil", "sqrt", "exp", "min", "max", "pow", "wrap", "clamp", "mix", "step", "smoothstep",

    r"\s+"          => { },
    r"//[^\n]*"     => { },
    r"--[^\n]*"     => { },
} else {
    r"`[^`]*`" => RAW_WGSL_LIT,
    // Rational literal: `INT/INT` with NO surrounding whitespace folds to a
    // single number, matching the hand tokenizer (`9/8` → 1.125). Longest-
    // match beats `INT "/" INT`; the no-whitespace requirement keeps `9 / 8`
    // a division op — byte-identical to the hand parser.
    r"[0-9]+/[0-9]+"                    => RATIONAL,
    r"[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?" => FLOAT_LIT,
    r"[0-9]+([eE][+-]?[0-9]+)?"         => INT_LIT,
    r"[a-zA-Z_][a-zA-Z0-9_]*"           => IDENT,
}

// ---------------------------------------------------------------------------
// Top-level entry points
// ---------------------------------------------------------------------------

pub Pipeline: WarpPipeline = {
    <src:SrcExpr> <ops:PipeTail> => WarpPipeline { source: src, ops },
};

// `state { water: a, organism: sy }` — composer-chosen names for channels.
StateEntry: (String, ast::Chan) = {
    <n:IDENT> ":" <c:IDENT> => (n.to_string(), h::parse_chan(&c)),
};
StateTail: Vec<(String, ast::Chan)> = {
    => vec![],
    "," => vec![],
    "," <e:StateEntry> <rest:StateTail> => {
        let mut v = vec![e];
        v.extend(rest);
        v
    },
};
StateBlock: Vec<(String, ast::Chan)> = {
    "state" "{" <first:StateEntry> <rest:StateTail> "}" => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};

// Entry used by the preprocessor: optional state block, then the pipeline.
pub PipelineWithState: (Vec<(String, ast::Chan)>, WarpPipeline) = {
    <p:Pipeline> => (vec![], p),
    <sb:StateBlock> <p:Pipeline> => (sb, p),
};

/// "Ops-only" pipeline used as an Iterate body when the first ident isn't a
/// source keyword. Synthesises `Source::Prev`.
pub OpsOnlyPipeline: WarpPipeline = {
    <first:Op> <rest:PipeTail> => {
        let mut ops = vec![first];
        ops.extend(rest);
        WarpPipeline { source: Source::Prev, ops }
    },
};

PipeTail: Vec<WarpOp> = {
    => vec![],
    "|" <op:Op> <rest:PipeTail> => {
        let mut v = vec![op];
        v.extend(rest);
        v
    },
};

// ---------------------------------------------------------------------------
// Sources
// ---------------------------------------------------------------------------
SrcExpr: Source = {
    "Prev"  => Source::Prev,
    "Scene" => Source::Scene,
    "Volume" => Source::Volume,

    "Osc" "{" <args:NamedArgList> "}" => {
        let (freq, sync, offset) = h::extract_osc_args(args);
        Source::Osc { freq, sync, offset }
    },
    "Noise" "{" <args:NamedArgList> "}" => {
        let (scale, offset) = h::extract_noise_args(args);
        Source::Noise { scale, offset }
    },
    "Gradient" "(" <x:Expr> "," <y:Expr> "," <z:Expr> ")" => Source::Gradient(x, y, z),
    "Solid" "(" <r:Expr> "," <g:Expr> "," <b:Expr> ")" =>
        Source::Solid(r, g, b),
};

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------
Op: WarpOp = {
    // Single-arg
    "Scale"       <e:BareOrParenArg> => WarpOp::Scale(e),
    "Rotate"      <e:BareOrParenArg> => WarpOp::Rotate(e),
    "Swirl"       <e:BareOrParenArg> => WarpOp::Swirl(e),
    "Fold"        <e:BareOrParenArg> => WarpOp::Fold(e),
    "Kaleid"      <e:BareOrParenArg> => WarpOp::Kaleid(e),
    "ChromaShift" <e:BareOrParenArg> => WarpOp::ChromaShift(e),
    "Decay"       <e:BareOrParenArg> => WarpOp::Decay(e),
    "Hue"         <e:BareOrParenArg> => WarpOp::Hue(e),
    "Gamma"       <e:BareOrParenArg> => WarpOp::Gamma(e),
    "Knee"        <e:BareOrParenArg> => WarpOp::Knee(e),
    "Gain"        <e:BareOrParenArg> => WarpOp::Gain(e),
    "Palette"     <e:BareOrParenArg> => WarpOp::Palette(e),
    "Blur"        <e:BareOrParenArg> => WarpOp::Blur(e),
    "Vignette"    <e:BareOrParenArg> => WarpOp::Vignette(e),
    "Posterize"   <e:BareOrParenArg> => WarpOp::Posterize(e),

    // Two-arg positional Scroll(x, y) — paren form only; the bare form
    // (`Scroll 0.1 0.2` without parens) was an undocumented edge case of
    // the hand parser that no shipped composition uses.
    "Scroll" "(" <x:Expr> "," <y:Expr> ")" => WarpOp::Scroll(x, y),

    // Three-arg positional Tint
    "Tint" "(" <r:Expr> "," <g:Expr> "," <b:Expr> ")" => WarpOp::Tint(r, g, b),

    // Named (brace) or positional (paren) — audio house style is positional;
    // braces are the order-independent readability escape hatch:
    //   Wave { freq: 3.5, amp: 0.1 }   -- named, order-independent
    //   Wave(3.5, 0.1)                 -- positional, same order as AST fields
    "Wave"     "{" <a:NamedArgList> "}" => {
        let (freq, amp) = h::extract_named_pair(a, "freq", "amp");
        WarpOp::Wave { freq, amp }
    },
    "Wave"     "(" <f:Expr> "," <a:Expr> ")" => WarpOp::Wave { freq: f, amp: a },

    "CurlFlow" "{" <a:NamedArgList> "}" => {
        let (amp, freq) = h::extract_named_pair(a, "amp", "freq");
        WarpOp::CurlFlow { amp, freq }
    },
    "CurlFlow" "(" <am:Expr> "," <fq:Expr> ")" => WarpOp::CurlFlow { amp: am, freq: fq },

    // Ripple(ch, ...) — a radial wave from channel ch's last note onset.
    // First arg is the hit channel (a literal); the rest named or positional.
    "Ripple" <c:ChanRef> "{" <a:NamedArgList> "}" => {
        let (freq, speed, amp) = h::extract_ripple_args(a);
        WarpOp::Ripple { ch: c, freq, speed, amp }
    },

    // Glow(ch, ...) — colored light pooling at channel ch's last onset.
    "Glow" <c:ChanRef> "{" <a:NamedArgList> "}" => {
        let (r, g, b, size) = h::extract_glow_args(a);
        WarpOp::Glow { ch: c, r, g, b, size }
    },

    // Displace(part, ...) — the generic hit-centered displacement.
    "Displace" <c:ChanRef> "{" <a:NamedArgList> "}" => {
        let (radial, tangent) = h::extract_displace_args(a);
        WarpOp::Displace { ch: c, radial, tangent }
    },

    // Stir(ch, ...) — a decaying vortex at channel ch's last note onset.
    "Stir" <c:ChanRef> "{" <a:NamedArgList> "}" => {
        let (radius, strength) = h::extract_stir_args(a);
        WarpOp::Stir { ch: c, radius, strength }
    },

    // Bulge(ch, ...) — a soft local swell at channel ch's last onset.
    "Bulge" <c:ChanRef> "{" <a:NamedArgList> "}" => {
        let (radius, amount, mirror) = h::extract_bulge_args(a);
        WarpOp::Bulge { ch: c, radius, amount, mirror }
    },

    // Relief(...) — collapse the source-as-height-field into lit 2D form.
    "Relief" "{" <a:NamedArgList> "}" => {
        let (height, lx, ly, ambient) = h::extract_relief_args(a);
        WarpOp::Relief { height, lx, ly, ambient }
    },

    // Stain(...) — soak the incoming field into a woven canvas as pigment.
    "Stain" "{" <a:NamedArgList> "}" => {
        let (r, g, b, strength, opacity) = h::extract_stain_args(a);
        WarpOp::Stain { r, g, b, strength, opacity }
    },

    // Watercolor(...) — one full sim step: water moves, pigment rides it.
    "Watercolor" "{" <a:NamedArgList> "}" => {
        let (wetness, drying, bleed, deposit, lift) = h::extract_watercolor_args(a);
        WarpOp::Watercolor { wetness, drying, bleed, deposit, lift }
    },

    // --- Substance verbs (MEDIUM.md M1). Structural args (channel, velocity)
    // are positional; the scalar knob is a brace bag (Law 6).
    "Diffuse" <f:Chan> "{" <a:NamedArgList> "}" =>
        WarpOp::Diffuse { field: f, rate: h::take_medium_arg(a, "Diffuse", "rate", 0.3), gated: None },
    "Diffuse" <f:Chan> "gated" <g:Chan> "{" <a:NamedArgList> "}" =>
        WarpOp::Diffuse { field: f, rate: h::take_medium_arg(a, "Diffuse", "rate", 0.3), gated: Some(g) },
    "Advect" <f:Chan> "by" <v:FieldSrc> "{" <a:NamedArgList> "}" => {
        let (amount, blend) = h::take_medium_arg2(a, "Advect", "amount", 1.0, "blend", 1.0);
        WarpOp::Advect { field: f, by: v, amount, blend }
    },
    "Force" <f:Chan> "from" <v:FieldSrc> "{" <a:NamedArgList> "}" =>
        WarpOp::Force { field: f, from: v, gain: h::take_medium_arg(a, "Force", "gain", 1.0) },
    "Decay" <f:Chan> <e:BareOrParenArg> => WarpOp::DecayField { field: f, by: e },
    "Deposit" <f:Chan> "{" <a:NamedArgList> "}" => {
        let (gain, grain, cap) = h::take_medium_arg3(a, "Deposit", "gain", 0.2, "grain", 0.0, "cap", 0.0);
        WarpOp::Deposit { field: f, gain, grain, cap }
    },
    "Set" <f:Chan> <e:BareOrParenArg> => WarpOp::Set { field: f, value: e },
    "Raymarch" "{" <a:NamedArgList> "}" => {
        let (fog, gain) = h::take_medium_arg2(a, "Raymarch", "fog", 1.2, "gain", 1.0);
        WarpOp::Raymarch { fog, gain }
    },
    "Propagate" <f:Chan> "{" <a:NamedArgList> "}" => {
        let (step, dry) = h::take_medium_arg2(a, "Propagate", "step", 3.0, "dry", 0.97);
        WarpOp::Propagate { field: f, step, dry }
    },
    "Flow" <f:Chan> "{" <a:NamedArgList> "}" => {
        let (x, y) = h::take_medium_arg2(a, "Flow", "x", 0.0, "y", 0.003);
        WarpOp::Flow { field: f, x, y, gated: None }
    },
    "Flow" <f:Chan> "gated" <g:Chan> "{" <a:NamedArgList> "}" => {
        let (x, y) = h::take_medium_arg2(a, "Flow", "x", 0.0, "y", 0.003);
        WarpOp::Flow { field: f, x, y, gated: Some(g) }
    },

    "Bloom"    "{" <a:NamedArgList> "}" => {
        let (threshold, strength) = h::extract_named_pair(a, "threshold", "strength");
        WarpOp::Bloom { threshold, strength }
    },
    "Bloom"    "(" <t:Expr> "," <s:Expr> ")" => WarpOp::Bloom { threshold: t, strength: s },

    // Optional named-args with defaults — brace bags (Law 6).
    "Clear" "{" <a:NamedArgList> "}" => {
        let (at, every, offset) = h::extract_clear_args(a);
        WarpOp::Clear { at, every, offset }
    },
    "Fade" "{" <a:NamedArgList> "}" => {
        let (at, every, offset, dur, to) = h::extract_fade_args(a);
        WarpOp::Fade { at, every, offset, dur, to }
    },
    "Background" "{" <a:BgArgList> "}" => {
        let f = h::extract_background_args(a);
        WarpOp::Background {
            top_r: f.0, top_g: f.1, top_b: f.2,
            bot_r: f.3, bot_g: f.4, bot_b: f.5,
            split: f.6, soft: f.7,
        }
    },
    "DepthVis" => WarpOp::DepthVis,
    "Opaque"   => WarpOp::Opaque,
    "Persist"  => WarpOp::Persist,
    "AsIs"     => WarpOp::AsIs,
    "None"     => WarpOp::Mute,

    "Raw" <s:RAW_WGSL_LIT> => WarpOp::Raw(s[1..s.len()-1].to_string()),

    // Compositors taking a sub-pipeline. The "extra" expr is positional and
    // separated by a comma; `Blend`/`Modulate` use it as their amount.
    "Max"      "(" <p:Pipeline> ")" => WarpOp::Max(Box::new(p)),
    "Add"      "(" <p:Pipeline> ")" => WarpOp::Add(Box::new(p)),
    "Screen"   "(" <p:Pipeline> ")" => WarpOp::Screen(Box::new(p)),
    "Mix"      "(" <p:Pipeline> "," <e:Expr> ")" => WarpOp::Mix(Box::new(p), e),
    "Mix"      "(" <p:Pipeline> ")"                => WarpOp::Mix(Box::new(p), WarpExpr::DefaultLit(0.5)),
    "Modulate" "(" <p:Pipeline> "," <e:Expr> ")" => WarpOp::Modulate(Box::new(p), e),
    "Modulate" "(" <p:Pipeline> ")" => WarpOp::Modulate(Box::new(p), WarpExpr::DefaultLit(0.1)),

    // Iterate body: either a full pipeline (starts with a source) or
    // ops-only (synthesises `Source::Prev`). LR(1) chooses based on the
    // first token's kind.
    "Iterate" <n:BareOrParenArg> "{" <p:Pipeline>        "}" =>
        WarpOp::Iterate(n, Box::new(p)),
    "Iterate" <n:BareOrParenArg> "{" <p:OpsOnlyPipeline> "}" =>
        WarpOp::Iterate(n, Box::new(p)),

    // Composition primitives
    "Overlay" "[" <layers:OverlayLayerList> "]" =>
        WarpOp::Overlay { layers },
    "Seq" "[" <phases:SeqPhaseList> "]" =>
        WarpOp::Seq { phases },

    // Cross-DSL FitLength: the rewrite pass in `warp::fit_length` consumes
    // this and rescales the preceding Seq's Lm values. If left unrewritten
    // (no preceding Seq, or name not in env), codegen emits nothing for it.
    "FitLength" <name:Name> => WarpOp::FitLength(name),
};

// ---------------------------------------------------------------------------
// Composition primitive bodies
// ---------------------------------------------------------------------------

OverlayLayerList: Vec<Vec<WarpOp>> = {
    => vec![],
    <first:OverlayLayer> <rest:OverlayTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};
OverlayTail: Vec<Vec<WarpOp>> = {
    => vec![],
    OverlaySep => vec![],
    OverlaySep <l:OverlayLayer> <rest:OverlayTail> => {
        let mut v = vec![l];
        v.extend(rest);
        v
    },
};
OverlaySep: () = { "," => (), ";" => () };
OverlayLayer: Vec<WarpOp> = {
    <first:Op> <rest:PipeTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};

SeqPhaseList: Vec<SeqPhase> = {
    => vec![],
    <first:SeqPhaseItem> <rest:SeqPhaseTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};
SeqPhaseTail: Vec<SeqPhase> = {
    => vec![],
    SeqSep => vec![],
    SeqSep <p:SeqPhaseItem> <rest:SeqPhaseTail> => {
        let mut v = vec![p];
        v.extend(rest);
        v
    },
};
SeqSep: () = { "," => (), ";" => () };

/// A Seq phase: 1+ ops chained with `|`, optionally followed by `| Lm N`.
SeqPhaseItem: SeqPhase = {
    <first:Op> <body:SeqPhaseBody> => {
        let (mut ops, length) = body;
        ops.insert(0, first);
        let explicit_length = length.is_some();
        SeqPhase {
            ops,
            length: length.unwrap_or(WarpExpr::DefaultLit(1.0)),
            explicit_length,
        }
    },
};
SeqPhaseBody: (Vec<WarpOp>, Option<WarpExpr>) = {
    => (vec![], None),
    "|" "Lm" <e:BareOrParenArg> => (vec![], Some(e)),
    "|" <op:Op> <rest:SeqPhaseBody> => {
        let (mut ops, len) = rest;
        ops.insert(0, op);
        (ops, len)
    },
};

// ---------------------------------------------------------------------------
// Named-arg lists
// ---------------------------------------------------------------------------
NamedArgList: Vec<(String, WarpExpr)> = {
    => vec![],
    <first:NamedArg> <rest:NamedArgTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};
NamedArgTail: Vec<(String, WarpExpr)> = {
    => vec![],
    "," <n:NamedArg> <rest:NamedArgTail> => {
        let mut v = vec![n];
        v.extend(rest);
        v
    },
};
NamedArg: (String, WarpExpr) = {
    <name:Name> ":" <e:Expr> => (name, e),
    // `step` became a math-fn keyword (step(edge, x)) — but it's also the
    // established arg key of `Propagate { step: … }`. Accept the keyword
    // spelling as a key so existing files keep parsing (the `by` lesson).
    "step" ":" <e:Expr> => ("step".to_string(), e),
};

BgArgList: Vec<(String, BgArgVal)> = {
    => vec![],
    <first:BgArg> <rest:BgArgTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};
BgArgTail: Vec<(String, BgArgVal)> = {
    => vec![],
    "," <a:BgArg> <rest:BgArgTail> => {
        let mut v = vec![a];
        v.extend(rest);
        v
    },
};
BgArg: (String, BgArgVal) = {
    <name:Name> ":" "(" <r:Expr> "," <g:Expr> "," <b:Expr> ")" =>
        (name, BgArgVal::Tuple3(r, g, b)),
    <name:Name> ":" <e:NonParenExpr> =>
        (name, BgArgVal::Scalar(e)),
};

// ---------------------------------------------------------------------------
// Common arg shapes
// ---------------------------------------------------------------------------

/// A scalar argument that may be bare or parenthesised. Both forms exist in
/// the wild (`Scale 0.99`, `Scale(0.99)`, `Hue(Time)`).
BareOrParenArg: WarpExpr = {
    "(" <e:Expr> ")" => e,
    <e:NonParenFactor> => e,
};

Name: String = { <s:IDENT> => s.to_string() };

// A hit-channel reference: the part's NAME (normal) or a raw slot (escape
// hatch). Kintaro resolves names to slots before codegen.
ChanRef: HitRef = {
    <s:IDENT> => HitRef::Name(s.to_string()),
    <n:Num> => HitRef::Idx((n as u32).min(127)),
};

// A field channel selector for substance verbs (r/g/b/a/rg/gb/rgb).
Chan: ast::Chan = { <s:IDENT> => h::parse_chan(&s) };

// A velocity / force source: a scalar field's gradient, or a 2-ch field.
FieldSrc: ast::FieldSrc = {
    "grad" "(" <c:Chan> ")" => ast::FieldSrc::Grad(c),
    "lap" "(" <c:Chan> ")"  => ast::FieldSrc::Lap(c),
    <c:Chan>                => ast::FieldSrc::Field(c),
};

// ---------------------------------------------------------------------------
// Expression grammar — standard precedence climbing with explicit levels.
//
// Two parallel grammars exist:
//   * `Expr / Term / Factor` — full expression, may start with `(`.
//   * `NonParenExpr / NonParenTerm / NonParenFactor` — same precedence but
//     the leading atom cannot be `(`. Used wherever a leading `(` would
//     conflict with a tuple syntax (Background, BareOrParenArg).
// ---------------------------------------------------------------------------

pub Expr: WarpExpr = {
    <l:Expr> "+" <r:Term> => WarpExpr::Bin(BinOp::Add, Box::new(l), Box::new(r)),
    <l:Expr> "-" <r:Term> => WarpExpr::Bin(BinOp::Sub, Box::new(l), Box::new(r)),
    <t:Term> => t,
};
Term: WarpExpr = {
    <l:Term> "*" <r:Factor> => WarpExpr::Bin(BinOp::Mul, Box::new(l), Box::new(r)),
    <l:Term> "/" <r:Factor> => WarpExpr::Bin(BinOp::Div, Box::new(l), Box::new(r)),
    <f:Factor> => f,
};
Factor: WarpExpr = {
    <n:Num> => WarpExpr::Lit(n),
    // warp has no per-element birth, so the frame clock is the only time —
    // `time` and `clock` are the same thing here (both lower to `time`).
    "time"  => WarpExpr::Clock,
    "Hit" "(" <c:ChanRef> ")" => WarpExpr::Hit(c),
    "HitX" "(" <c:ChanRef> ")" => WarpExpr::HitX(c),
    "HitY" "(" <c:ChanRef> ")" => WarpExpr::HitY(c),
    "Dist" "(" <c:ChanRef> ")" => WarpExpr::Dist(c),
    "HitAge" "(" <c:ChanRef> ")" => WarpExpr::HitAge(c),
    "clock" => WarpExpr::Clock,
    "Sin" "(" <f:Expr> ")" =>
        WarpExpr::Sin { freq: Box::new(f), amp: Box::new(WarpExpr::DefaultLit(1.0)) },
    "Sin" "(" <f:Expr> "," <a:Expr> ")" =>
        WarpExpr::Sin { freq: Box::new(f), amp: Box::new(a) },
    <f:UnaryFn> "(" <a:Expr> ")" => WarpExpr::Call(f, vec![a]),
    <f:BinaryFn> "(" <a:Expr> "," <b:Expr> ")" => WarpExpr::Call(f, vec![a, b]),
    <f:TernaryFn> "(" <a:Expr> "," <b:Expr> "," <c:Expr> ")" => WarpExpr::Call(f, vec![a, b, c]),
    // Variadic min/max (≥2): left-fold into nested binary calls.
    <f:VariadicFn> "(" <a:Expr> <rest:("," <Expr>)+> ")" =>
        rest.into_iter().fold(a, |acc, e| WarpExpr::Call(f, vec![acc, e])),
    "(" <e:Expr> ")" => e,
    "-" <f:Factor>   =>
        WarpExpr::Bin(BinOp::Sub, Box::new(WarpExpr::DefaultLit(0.0)), Box::new(f)),
    // A field read by name — builtin channel ("a", "sx") or a `state {}`
    // declared name ("water"). Canonicalised by kintaro's resolve-fields pass.
    <s:IDENT> => WarpExpr::Field(s.to_string()),
};

// Math-function names grouped by arity (see `dsl_expr::MathFn`).
UnaryFn: MathFn = {
    "sin" => MathFn::Sin, "cos" => MathFn::Cos, "abs" => MathFn::Abs,
    "floor" => MathFn::Floor, "ceil" => MathFn::Ceil, "sqrt" => MathFn::Sqrt, "exp" => MathFn::Exp,
};
BinaryFn: MathFn = { "pow" => MathFn::Pow, "wrap" => MathFn::Wrap, "step" => MathFn::Step };
TernaryFn: MathFn = { "clamp" => MathFn::Clamp, "mix" => MathFn::Mix, "smoothstep" => MathFn::Smoothstep };
VariadicFn: MathFn = { "min" => MathFn::Min, "max" => MathFn::Max };

NonParenExpr: WarpExpr = {
    <l:NonParenExpr> "+" <r:Term> =>
        WarpExpr::Bin(BinOp::Add, Box::new(l), Box::new(r)),
    <l:NonParenExpr> "-" <r:Term> =>
        WarpExpr::Bin(BinOp::Sub, Box::new(l), Box::new(r)),
    <t:NonParenTerm> => t,
};
NonParenTerm: WarpExpr = {
    <l:NonParenTerm> "*" <r:Factor> =>
        WarpExpr::Bin(BinOp::Mul, Box::new(l), Box::new(r)),
    <l:NonParenTerm> "/" <r:Factor> =>
        WarpExpr::Bin(BinOp::Div, Box::new(l), Box::new(r)),
    <f:NonParenFactor> => f,
};
NonParenFactor: WarpExpr = {
    <n:Num> => WarpExpr::Lit(n),
    "time"  => WarpExpr::Clock,
    "Hit" "(" <c:ChanRef> ")" => WarpExpr::Hit(c),
    "HitX" "(" <c:ChanRef> ")" => WarpExpr::HitX(c),
    "HitY" "(" <c:ChanRef> ")" => WarpExpr::HitY(c),
    "Dist" "(" <c:ChanRef> ")" => WarpExpr::Dist(c),
    "HitAge" "(" <c:ChanRef> ")" => WarpExpr::HitAge(c),
    "clock" => WarpExpr::Clock,
    "Sin" "(" <f:Expr> ")" =>
        WarpExpr::Sin { freq: Box::new(f), amp: Box::new(WarpExpr::DefaultLit(1.0)) },
    "Sin" "(" <f:Expr> "," <a:Expr> ")" =>
        WarpExpr::Sin { freq: Box::new(f), amp: Box::new(a) },
    <f:UnaryFn> "(" <a:Expr> ")" => WarpExpr::Call(f, vec![a]),
    <f:BinaryFn> "(" <a:Expr> "," <b:Expr> ")" => WarpExpr::Call(f, vec![a, b]),
    <f:TernaryFn> "(" <a:Expr> "," <b:Expr> "," <c:Expr> ")" => WarpExpr::Call(f, vec![a, b, c]),
    <f:VariadicFn> "(" <a:Expr> <rest:("," <Expr>)+> ")" =>
        rest.into_iter().fold(a, |acc, e| WarpExpr::Call(f, vec![acc, e])),
    "-" <f:NonParenFactor> =>
        WarpExpr::Bin(BinOp::Sub, Box::new(WarpExpr::DefaultLit(0.0)), Box::new(f)),
};

Num: f32 = {
    <s:INT_LIT>   => s.parse().unwrap(),
    <s:FLOAT_LIT> => s.parse().unwrap(),
    <s:RATIONAL>  => h::parse_rational(s),
};

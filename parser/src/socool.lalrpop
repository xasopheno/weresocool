grammar<'defs>(
    defs: &'defs mut Defs,
);

extern {
    type Error = String;
}

match {
    // Skip whitespace and comments
    r"\s*" => {},
    r"--[^\n\r]*" => {},  // -- style comments (to end of line)
    r"//[^\n\r]*" => {},  // // style comments (to end of line)
    // Match everything else
    _
}

pub SoCool: Init = {
  <init: Point>
  <l: LetDefs> => init 
}

Point: Init = {
    "{"
         <f_axis: F> <f: Rational> ","
         <l_axis: L> <l: Rational> ","
         <g_axis: G> <g: Rational> ","
         <p_axis: P> <p: Rational>
         <opt_bg: OptionalBackgroundColor>  
    "}" ";"? => Init {
         f,
         l,
         g,
         p,
         background_color: opt_bg
    }
}

OptionalBackgroundColor: Option<ColorValue> = {
    "," "background_color:" <bg: CssOrHex> => Some(ColorValue::Color(bg)),
    => None
};

LetDefs = Lets<LetDef>;
LetDef: () = {
    <start: @L> <s: Name> "(" <vars: Comma<Name>>  ")" "=" "{" <o: Operation> "}" <end: @R> => {
        defs.spans.insert_def(s.clone(), Span::new(start, end));
        defs.ops.insert("global",
             s.to_owned(),
             Term::FunDef(FunDef {
                 name: s,
                 vars: vars,
                 term: Box::new(o)
             })
         );
        ()
    },

    <start: @L> <s: Name> "=" "{" <o: Operation> "}" <end: @R> => {
        defs.spans.insert_def(s.clone(), Span::new(start, end));
        defs.ops.insert("global", s.to_owned(), o); ()
    },

    <start: @L> <name: Name> "=" <list: List> <end: @R> => {
        defs.spans.insert_def(name.clone(), Span::new(start, end));
        defs.ops.insert("global", name.to_owned(), Term::Lop(list)); ()
    },

    <start: @L> <name: Name> "=" <generator: Generator> <end: @R> => {
        defs.spans.insert_def(name.clone(), Span::new(start, end));
        defs.ops.insert("global", name.to_owned(), Term::Gen(generator)); ()
    },

    <stems: Stems> =>{
      defs.ops.stems.extend(stems); ()
    }
};


Operation: Term = {
    <op1: Operation> ">" "FitGain" <op2: ComposeOperation> => {
      unimplemented!()
    },

    // TODO: Revisit Focus/Lens
    <op1: Operation> ">" "@" <name: Name> <op2: ComposeOperation> => {
        Term::Op(
            Focus {
                name: name,
                main: Box::new(op1.to_owned()),
                op_to_apply: Box::new(op2.to_owned()),
            }
        )
    },

    <op: ComposeOperation> => op,

    <list: List> => Term::Lop(list),

    <generator: Generator> => Term::Gen(generator)
}

Generator: GenOp = {
  <generator: GeneratorBase> "Take" <n: Int> <seed: ("Seed" Int)?> => {
    GenOp::init_taken(generator, n as usize, seed)
  },
  <generator: GeneratorBase> => generator

}

GeneratorBase: GenOp = {
  r"(Gen|\*)" "(" <coefs: Comma<CoefState>> ")" <seed: ("Seed" Int)?>   =>  {
    GenOp::init_const(Generator {coefs}, seed)
  },

  r"(Gen|\*)" <name: Name> <seed: ("Seed" Int)?>  => {
    GenOp::init_named(name, seed)
  },
}


CoefState: CoefState = {
  <axis: Axis> <div: CoefStart> <coefs: Coefs> => { 
    CoefState::new(
      div.0,
      div.1,
      axis,
      coefs
     )
  }
}


Coefs: Coefs = {
  "[" <coefs: Comma<Coef>> "]" => Coefs::init_const(coefs),
  "Poly" "[" <coefs: Comma<Rational>> "]" => Coefs::init_polynomial(coefs) ,
  "Expr" <expr: Expr> => {
    Coefs::init_expr(expr[1..expr.len() -1].to_string())
  }
}

Expr: String = <s:r#"`(.*)`"#> => s.to_string();

CoefType: Coef = {
  "RR" "(" <start: Int> ".." <end: Int> ")" => Coef::RandRange(start..=end),
  "RC" "(" <choices: Comma<ChoiceTimes>> ")" => Coef::RandChoice(choices.into_iter().flatten().collect()),
  <v: Int> => Coef::Int(v)
}

Coef: Vec<Coef> = {
  <coef: CoefType> <times: CoefTimes> => vec![coef; times],
  <coef: CoefType> => vec![coef]

}

ChoiceTimes: Vec<i64> = {
  <coef: Int> <times: CoefTimes> => vec![coef; times],
  <coef: Int> => vec![coef]
}

CoefTimes: usize = {
  <s:r"\*([0-9]+)"> => {
    let regex = Regex::new("\\*([0-9]+)").unwrap();
    let captures = regex.captures(s).unwrap();
    let n = captures[1].parse::<usize>().unwrap();
   
    n as usize
  }
} 


List: ListOp = {
  <listops: ListConcat> => ListOp::Concat{ listops },
  <list: ListIndexed> => list,

}

ListConcat = Concat<ListIndexed>;

ListIndexed: ListOp = {
  <listop: ListIndexed> "@" "[" <indices: Indices> "]" => {
    ListOp::ListOpIndexed { list_op: Box::new(listop), indices, direction: Direction::Sequence}
  },

  <listop: ListIndexed> "%" "[" <indices: Indices> "]" => {
    ListOp::ListOpIndexed { list_op: Box::new(listop), indices, direction: Direction::Overlay}
  },

   "<" <list: List> ">" => list,

  <list: ListBase> => list,
}

ListBase: ListOp = {
  r"(List|&)" "[" <terms: Operations> "]" => {
    ListOp::Const{ terms }
  },

  r"(List|&)" <name: Name> => {
    ListOp::Named { name }
  },

  "ET" "(" <n: Int> ")" => {
    ListOp::Const{ terms: et(n) }
  },

  r"(List|&)" <generator: Generator> => ListOp::GenOp { generator }
}

Indices: Indices = {
  <indices: Comma<Index>> => Indices(indices),
};

Index: Index = {
  <index: Int> => Index::Const { indices: vec![index] },
  "(" <indices: Comma<Int>> ")" => Index::Const { indices },
  <start: Int?>":"<end: Int?><skip: (":" Int)?> => { 
      match skip {
        Some(skip) => Index::Slice { start, end, skip: skip.1 },
        None => Index::Slice { start, end, skip: 1 }
      }
  },
  "Random" "(" <n: Int> <seed: ("," Int)?> ")" => {
      match seed {
        Some(seed) => {
          Index::Random { n, seed: seed.1 }
        },
        None => {
          Index::Random { n, seed: random_seed() }
        }
      }
  },
  <index: Index> "|" <term: Composeable> => Index::IndexAndTerm {index: Box::new(index), term},
} 

ComposeOperation: Term = {
    <terms: Pipe<Composeable>> => {
      Term::Op(Compose { operations: handle_fit_length_recursively(handle_repeat_recursively(terms)) })
    },
    <o: BaseOperation> => o,
}


Composeable: Term = {
  <base_operation: BaseOperation> => base_operation,
  <list: List> => Term::Lop(list),
  <generator: Generator> => Term::Gen(generator),
}

Scale: Scale = {
  <axis: Axis> <value: Rational> => Scale { axis, value }
}

BaseOperation: Term = {
    "Csv1d" <scale: Parenthesized<Rational>?> <path: Import>  => Term::Op(CSV1d { path, scale }),
    "Csv2d" <scales: Parenthesized<Comma<Scale>>> <path: Import>  => Term::Op(CSV2d { path, scales }),
    "FromSound" "(" <voices: Int> "," <fps: Int> ")" <path: AudioImport>  => Term::Op(FromSound { path, voices: voices as usize, fps: fps as usize }),
    "FromSound" "(" <voices: Int> ")" <path: AudioImport>  => Term::Op(FromSound { path, voices: voices as usize, fps: 30 }),
    "FromSoundYin" "(" <fps: Int> ")" <path: AudioImport>  => Term::Op(FromSoundYin { path, fps: fps as usize }),
    //
    <wgsl_token: r"@WGSL@[0-9]+"> => {
        // Extract the u64 ID from the token
        let id = wgsl_token.trim_start_matches("@WGSL@").parse::<u64>().unwrap();
        Term::Op(WGSL(id))
    },
    //
    r"\\|Lambda" <input_name: Parenthesized<Name>?> "{" <term: Operation> "}" => Term::Op(Lambda { term: Box::new(term),
        input_name, scope: uuid::Uuid::new_v4().to_string()}),
    "(" <o: Operation> ")" => o,
    <follow: Follow> => Term::Op(Follow(follow)),
    <fm: Fm> <m:Rational> => Term::Op(TransposeM {m}),
    <fa: Fa> <a:Rational> => Term::Op(TransposeA {a}),
    <pm: Pm>  <m:Rational> => Term::Op(PanM {m}),
    <pa: Pa>   <a:Rational> => Term::Op(PanA {a}),
    <lm: Lm> <m:Rational> => Term::Op(Length {m}),
    <gain: Gm> <m:Rational> => Term::Op(Gain {m}),
    r"Lowpass|LowPass" <c:Rational> <q:Rational> => Term::Op(Lowpass {
      hash: generate_random_hash_string(),
      cutoff_frequency: c, 
      q_factor: q
    }),
    r"Highpass|HighPass" <c:Rational> <q:Rational> => Term::Op(Highpass {
      hash: generate_random_hash_string(),
      cutoff_frequency: c, 
      q_factor: q
    }),
    r"Bandpass|BandPass" <c:Rational> <q:Rational> => Term::Op(Bandpass {
      hash: generate_random_hash_string(),
      cutoff_frequency: c, 
      q_factor: q
    }),
    "AsIs" => Term::Op(AsIs {}),
    "Out" => Term::Op(Out {}),
    "Sine" <pow: Rational?> => {
      Term::Op(Sine { pow })
    },
    "Sine" "[" <pows: Comma<Rational>> "]" => {
        let mut operations = Vec::new();
        for pow in pows {
            operations.push(Term::Op(Sine { pow: Some(pow) }))
        }
        Term::Op(Sequence { operations })
    },
    "FmOsc" "[" <osc_defs: Comma<FMOvertoneDef>> "]" => Term::Op(FMOsc { 
        defs: osc_defs.iter().map(|d| FmOscDef {
          fm: d.0, 
          depth: d.1
        }).collect()
      }),
    r"Triangle|Tri" <pow: Rational?> => {
      Term::Op(Triangle { pow })
    },
    r"Saw" => {
      Term::Op(Saw)
    },
    r"Triangle|Tri" "[" <pows: Comma<Rational>> "]" => {
        let mut operations = Vec::new();
        for pow in pows {
            operations.push(Term::Op(Triangle { pow: Some(pow) }))
        }
        Term::Op(Sequence { operations })
    },
    r"Square|Pulse" <width: Rational?> => {
      Term::Op(Square { width })
    },
    r"Square|Pulse" "[" <widths: Comma<Rational>> "]" => {
        let mut operations = Vec::new();
        for width in widths {
            operations.push(Term::Op(Square { width: Some(width) }))
        }
        Term::Op(Sequence { operations })
    },
    "Noise" => Term::Op(Noise {}),
    // Drum synthesis - with optional configurable parameters
    "Kick" => Term::Op(Kick { params: None }),
    "Kick" "{" <params: KickParamList> "}" => Term::Op(Kick { params: Some(params) }),
    "Snare" => Term::Op(Snare { params: None }),
    "Snare" "{" <params: SnareParamList> "}" => Term::Op(Snare { params: Some(params) }),
    "HiHat" => Term::Op(HiHat { open: false, params: None }),
    "HiHat" "{" <params: HiHatParamList> "}" => Term::Op(HiHat { open: false, params: Some(params) }),
    "OpenHat" => Term::Op(HiHat { open: true, params: None }),
    "OpenHat" "{" <params: HiHatParamList> "}" => Term::Op(HiHat { open: true, params: Some(params) }),
    "Reverse" => Term::Op(Reverse {}),
    "Invert" => Term::Op(FInvert),
    "Repeat" <i: Int> => {
        let mut vec = Vec::new();
        for x in 0..i {
            vec.push(Term::Op(AsIs))
        }
        Term::Op(Sequence { operations: vec })
    },
    "AD" "("
        <attack:Rational> ","
        <decay: Rational> ","
        <decay_type: Int> ")" => { 
          let asr = if decay_type == 2 {ASR::Long} else {ASR::Short};
          Term::Op(AD {attack, decay, asr})
        },
    "Portamento" <m:Rational> => Term::Op(Portamento {m}),
    "Reverb" <m:Rational> => Term::Op(Reverb {m: Some(m)}),
    "Wavefolder" "(" <threshold:Rational> "," <stages:Int> <gains:("," Rational "," Rational)?> ")" => {
        let (input_gain, output_gain) = gains
            .map(|(_, i, _, o)| (i, o))
            .unwrap_or((Rational64::new(1, 1), Rational64::new(1, 1)));
        Term::Op(Wavefolder { threshold, stages, input_gain, output_gain })
    },
    "SoftClip" "(" <threshold:Rational> <gains:("," Rational "," Rational)?> ")" => {
        let (input_gain, output_gain) = gains
            .map(|(_, i, _, o)| (i, o))
            .unwrap_or((Rational64::new(1, 1), Rational64::new(1, 1)));
        Term::Op(SoftClip { threshold, input_gain, output_gain })
    },
    "Overdrive" "(" <input_gain:Rational> <output_gain:("," Rational)?> ")" => {
        let output_gain = output_gain.map(|(_, o)| o).unwrap_or(Rational64::new(1, 1));
        Term::Op(Overdrive { input_gain, output_gain })
    },
    "Bitcrusher" "(" <bits:Int> <gains:("," Rational "," Rational)?> ")" => {
        let (input_gain, output_gain) = gains
            .map(|(_, i, _, o)| (i, o))
            .unwrap_or((Rational64::new(1, 1), Rational64::new(1, 1)));
        Term::Op(Bitcrusher { bits, input_gain, output_gain })
    },
    "Tanh" "(" <input_gain:Rational> <output_gain:("," Rational)?> ")" => {
        let output_gain = output_gain.map(|(_, o)| o).unwrap_or(Rational64::new(1, 1));
        Term::Op(Tanh { input_gain, output_gain })
    },
    "Silence" <m:Rational> => Term::Op(Silence {m}),
    <seq_kw: r"Sequence|Seq"> "[" <operations: Operations> "]" => Term::Op(Sequence {
        operations: operations
    }),
    "Overlay" "[" <operations: Operations> "]" => Term::Op(Overlay { operations: operations }),
    r"(ModulateBy|ModBy)" "[" <operations: Operations> "]" "->" "[" <output: Operations> "]" => Term::Op(ModulateBy { operations: operations, output: Some(output) }),
    r"(ModulateBy|ModBy)" "[" <operations: Operations> "]" => Term::Op(ModulateBy { operations: operations, output: None }),
    "Choose" "[" <operations: Operations> "]" => Term::Op(Choose { operations: operations }),
    // Midi pipe: Midi(10) or Midi[10,11]
    r"Midi" "(" <ch: Int> ")" => Term::Op(Midi { channels: vec![(ch as i64).clamp(1, 16) as u8] }),
    r"Midi" "[" <chs: Comma<Int>> "]" => Term::Op(Midi { channels: chs.into_iter().map(|c| (c as i64).clamp(1,16) as u8).collect() }),
    // Color grading operations
    "Hue" <value: Rational> => Term::Op(Hue { value }),
    "Saturation" <value: Rational> => Term::Op(Saturation { value }),
    "Brightness" <value: Rational> => Term::Op(Brightness { value }),
    "Vibrance" <value: Rational> => Term::Op(Vibrance { value }),
    "Gamma" <value: Rational> => Term::Op(Gamma { value }),
    <start:@L> "Blend" <color: CssOrHex> <amount: Rational> =>? {
        match parse_color_set(vec![color], None) {
            Ok(cv) => Ok(Term::Op(ColorBlend {
                color_id: defs.colors.insert(cv),
                amount
            })),
            Err(bad_color) => Err(lalrpop_util::ParseError::User {
                error: format!("{}:{}", start, bad_color)
            })
        }
    },
    <start:@L> "AddColor" <color: CssOrHex> =>? {
        match parse_color_set(vec![color], None) {
            Ok(cv) => Ok(Term::Op(ColorAdd {
                color_id: defs.colors.insert(cv)
            })),
            Err(bad_color) => Err(lalrpop_util::ParseError::User {
                error: format!("{}:{}", start, bad_color)
            })
        }
    },
    "Gradient" "(" <x: Rational> "," <y: Rational> "," <z: Rational> ")" => Term::Op(ColorGradient { x, y, z }),
    "Mix" <amount: Rational> => Term::Op(ColorMix { amount }),
    "FitLength" <op: Composeable> => {
        Term::Op(
            WithLengthRatioOf { with_length_of: Box::new(op), main: None }
        )
    },
    "O" "[" <o: Overtones> "]" => Term::Op(Overlay { operations: o }),
    <id: Name> => {
        Term::Op(Id(id))
    },
    "#"<name: Name> => Term::Op(Tag(name)),
    "$"<name: Name> => Term::Op(Keeper(name)),

    <name: Name> "(" <args: Comma<Operation>>  ")" => {
        Term::Op(
            FunctionCall {
                name,
                args
            }
        )
    },
    <fm: Rational>"^"<length: Rational> => {
        Term::Op(Compose { operations: vec! [
            Term::Op(TransposeM { m: fm }),
            Term::Op(Length { m: length }),
        ]})
    },
    BracedOvertone,
    ColorValue,
};

FMOvertoneDef: (Rational64, Rational64) = {
   "(" <overtone: Rational> "," <strength:Rational> ")" => (overtone, strength),
}

Overtone: Term = {
    "("
        <fm:Rational> ","
        <fa:Rational> ","
        <g:Rational> ","
        <p:Rational>
    ")"
    => Term::Op(Compose { operations: vec! [
            Term::Op(TransposeM { m: fm }),
            Term::Op(TransposeA { a: fa }),
            Term::Op(Gain { m: g }),
            Term::Op(PanA { a: p }),
        ]
    })
}

BracedOvertone: Term = {
    "{"
        <fm:Rational> ","
        <fa:Rational> ","
        <g:Rational> ","
        <p:Rational>
    "}"
    => Term::Op(Compose { operations: vec! [
            Term::Op(TransposeM { m: fm }),
            Term::Op(TransposeA { a: fa }),
            Term::Op(Gain { m: g }),
            Term::Op(PanA { a: p }),
        ]
    })
}



Parenthesized<T>: T = {
    <t: T> => t,
    "(" <t: T> ")" => t,
};

Lets<T>: Vec<T> = {
  <v:(<T>)*> => v
};
Overtones = Comma<Overtone>;
Compose = Pipe<Operation>;
Operations = Comma<Operation>;
CoefStart: (i64, i64) = {
    <n: Int> "|" <d:Int> => (n, d),
}

Follow: Follow = {
    "Follow {" <rules: Comma<FollowRule>> "}" => Follow { rules }
};

FollowRule: FollowRule = {
    <cond: FollowCondition> "->" <act: FollowAction> => FollowRule::Conditional { condition: cond, action: act },
    "_" "->" <act: FollowAction> => FollowRule::Default(act),
};

FollowCondition: FollowCondition = {
    <left: FollowCondition> "||" <right: FollowAndCondition> => FollowCondition::Or(Box::new(left), Box::new(right)),
    <and: FollowAndCondition> => FollowCondition::And(and),
};

FollowAndCondition: FollowAndCondition = {
    <left: FollowAndCondition> "&&" <right: FollowSimpleCondition> => FollowAndCondition::And(Box::new(left), Box::new(right)),
    <simple: FollowSimpleCondition> => FollowAndCondition::Simple(simple),
};

FollowSimpleCondition: FollowSimpleCondition = {
    <comp: FollowComparison> => FollowSimpleCondition::Comparison(comp),
    "(" <cond: FollowCondition> ")" => FollowSimpleCondition::Nested(Box::new(cond)),
};

FollowComparison: FollowComparison = {
    <var: FollowVariable> ">" <value: Rational> => FollowComparison::GreaterThan(var, value),
    <var: FollowVariable> "<" <value: Rational> => FollowComparison::LessThan(var, value),
    <var: FollowVariable> "==" <value: Rational> => FollowComparison::EqualTo(var, value),
};

FollowVariable: FollowVariable = {
    "F" => FollowVariable::F,
    "G" => FollowVariable::G,
};

FollowAction: FollowAction = {
    "{" <expr_f: FollowExpr> "," <expr_g: FollowExpr> "}" => FollowAction { expr_f, expr_g },
};

FollowExpr: FollowExpr = {
    <value: Rational> => FollowExpr::Value(value),
    <var: FollowVariable> => FollowExpr::Variable(var),
};

ColorValue: Term = {
    //"ColorGrad[" <colors: Comma<CssOrHex>> "]" => todo!(),
    <start:@L> "Color" "[" <colors: Comma<CssOrHex>> "]" =>? {
        match parse_color_set(colors, None) {
            Ok(cv) => Ok(Term::Op(Color(defs.colors.insert(cv)))),
            Err(bad_color) => Err(lalrpop_util::ParseError::User {
                error: format!("{}:{}", start, bad_color)
            })
        }
    },
    "RandColor" => todo!(),
};

CssOrHex: CssOrHex = {
    <hex: r#"#[0-9a-fA-F]{6}"#>  => CssOrHex::Hex(hex.to_string()),
    <css: Name> => CssOrHex::Css(css),
};

Comma<T>: Vec<T> = {
    <v:(<T> ",")*> <e:T?> => match e {
        None=> v,
        Some(e) => {
            let mut v = v;
            v.push(e);
            v
        }
    }
};

Pipe<T>: Vec<T> = {
    <v:(<T> "|")+> <e:T?> => match e {
        None=> v,
        Some(e) => {
          let mut v = v;
          v.push(e);
          v
        }
    }
};

Concat<T>: Vec<T> = {
    <v:(<T> "++")+> <e:T?> => match e {
        None=> v,
        Some(e) => {
          let mut v = v;
          v.push(e);
          v
        }
    }
};

// Drum parameter lists
KickParamList: KickParams = {
    <params: Comma<KickParam>> => {
        let mut result = KickParams::default();
        for (name, value) in params {
            match name.as_str() {
                // Meta-parameters
                "punch" => result.punch = Some(value),
                "body" => result.body = Some(value),
                "air" => result.air = Some(value),
                "dynamics" => result.dynamics = Some(value),
                // Specific parameters
                "pitch_decay" => result.pitch_decay = Some(value),
                "pitch_range" => result.pitch_range = Some(value),
                "amp_decay" => result.amp_decay = Some(value),
                "sub_amount" => result.sub_amount = Some(value),
                "click_amount" => result.click_amount = Some(value),
                "click_freq" => result.click_freq = Some(value),
                "attack" => result.attack = Some(value),
                "harmonic_damping" => result.harmonic_damping = Some(value),
                "saturation" => result.saturation = Some(value),
                "velocity_tilt" => result.velocity_tilt = Some(value),
                "transient_curve" => result.transient_curve = Some(value),
                _ => {}
            }
        }
        result
    }
};

KickParam: (String, Rational64) = {
    <name: Name> ":" <value: Rational> => (name, value),
};

SnareParamList: SnareParams = {
    <params: Comma<SnareParam>> => {
        let mut result = SnareParams::default();
        for (name, value) in params {
            match name.as_str() {
                // Meta-parameters
                "punch" => result.punch = Some(value),
                "body" => result.body = Some(value),
                "air" => result.air = Some(value),
                "dynamics" => result.dynamics = Some(value),
                // Specific parameters
                "pitch_decay" => result.pitch_decay = Some(value),
                "pitch_range" => result.pitch_range = Some(value),
                "shell_decay" => result.shell_decay = Some(value),
                "wire_decay" => result.wire_decay = Some(value),
                "wire_mix" => result.wire_mix = Some(value),
                "shell_tune" => result.shell_tune = Some(value),
                "attack" => result.attack = Some(value),
                "shell_pitch_decay" => result.shell_pitch_decay = Some(value),
                "shell_pitch_range" => result.shell_pitch_range = Some(value),
                "head_damping_ratio" => result.head_damping_ratio = Some(value),
                "saturation" => result.saturation = Some(value),
                "velocity_tilt" => result.velocity_tilt = Some(value),
                // Backwards compatibility aliases
                "tone_decay" => result.tone_decay = Some(value),
                "noise_decay" => result.noise_decay = Some(value),
                "noise_mix" => result.noise_mix = Some(value),
                _ => {}
            }
        }
        result
    }
};

SnareParam: (String, Rational64) = {
    <name: Name> ":" <value: Rational> => (name, value),
};

HiHatParamList: HiHatParams = {
    <params: Comma<HiHatParam>> => {
        let mut result = HiHatParams::default();
        for (name, value) in params {
            match name.as_str() {
                // Meta-parameters
                "punch" => result.punch = Some(value),
                "body" => result.body = Some(value),
                "air" => result.air = Some(value),
                "dynamics" => result.dynamics = Some(value),
                // Specific parameters
                "decay" => result.decay = Some(value),
                "shimmer" => result.shimmer = Some(value),
                "brightness" => result.brightness = Some(value),
                "attack" => result.attack = Some(value),
                "pitch_drop" => result.pitch_drop = Some(value),
                "saturation" => result.saturation = Some(value),
                "velocity_tilt" => result.velocity_tilt = Some(value),
                _ => {}
            }
        }
        result
    }
};

HiHatParam: (String, Rational64) = {
    <name: Name> ":" <value: Rational> => (name, value),
};

Ints = Comma<Int>;

Rational: Rational64 = {
    <n: Float> => f32_to_rational(n),
    <n: Exponential> => exponential_to_rational(n),
    <n: Int> => Rational64::new(n, 1),
    <n: Int> "/" <d:Int> => Rational64::new(n, d),
};

Axis: Axis = {
    F => Axis::F,
    G => Axis::G,
    L => Axis::L,
    P => Axis::P,
};

Stems: Vec<String> = {
  "->" "[" <names: Comma<Name>> "]" => names 
}

Fm: String = <s: r"Fm|Tm"> => s.to_string();
Fa: String = <s: r"Fa|Ta"> => s.to_string();
Gm: String = <s: r"Gain|Gm"> => s.to_string();
Lm: String = <s: r"Length|Lm"> => s.to_string();
Pm: String = <s: r"PanM|Pm"> => s.to_string();
Pa: String = <s: r"PanA|Pa"> => s.to_string();

F: String = <s: r"f:"> => s.to_string();
G: String = <s: r"g:"> => s.to_string();
L: String = <s: r"l:"> => s.to_string();
P: String = <s: r"p:"> => s.to_string();

Import: String = <s:r"(\.?\./)+[a-zA-Z0-9_/]+\.csv"> => s.to_string();
AudioImport: String = <s:r"(\.?\./)+[a-zA-Z0-9_/\-\.]+\.(wav|WAV|mp3|MP3)"> => s.to_string();
Name: String = <s:r"[a-z_][a-zA-Z_0-9.]*"> => s.to_string();
Float: String = <s:r"-?(0|([1-9]\d*))\.\d+"> => s.to_string();
Exponential: String = <s:r"-?(0|([1-9]\d*))\.\d+(?:[eE]([-+]?\d+))"> => s.to_string();
Int: i64 = <s:r"-?[0-9]+"> => i64::from_str(s).unwrap();

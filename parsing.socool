{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        {1/1, 2, 1, 1},
        {1/1, 0, 1, -1},
        {1/1, 0, 1, 0},
    ]
    | Choose [
        Seq [Fm 1, Fm 9/8, Fm 5/4] | Overlay [Fm 1, Fm 2] | Color [red], 
        Seq [Fm 2, Fm 3/2, Fm 5/4, Fm 4/3, Fm 5/4, Fm 9/8, Fm 3/4, Fm 3/4 | Lm 1/4, Fm 0] | Lm 1/5 | Color [cyan] | Fm 2 | Overlay [Fa 0, Fa 7],
        Fm 1/2 | Lm 3 | Color [blue], 
        Seq [Fm 3/2, Fm 9/4, Fm 5/4, Fm 5/3, Fm 0 | Lm 6] | Lm 1/3 | Color [green], 
        Fm 3/2 | Overlay [Fm 1/2, Fm 3/2, Fm 1] | Color [yellow],
        Fm 2/3 | Lm 2 | Color [purple],
        Seq [Fm 3/2, Fm 5/6] | Repeat 4 | Lm 1/4 | Color [orange],
        Seq [Fm 0 | Lm 2, Fm 3/2, Fm 3/4, Fm 0 | Lm 2] | Lm 1/2 | Color [pink], 
    ] 
    | Choose [AsIs, Reverse]
    | Repeat 10
    | FitLength Lm 16
}

f(a) = {
    a
}

main = {
    Overlay [
        Seq [Fm 1, Fm 0, Fm 0] | Lm 1/8,
        Fm 0,
        Gm 1/8,
    ]
    | Overlay [
        thing1 | Fm 2 | Pm 1/2 | wgsl { Xm 2; },
        thing1 | Fm 3/2 | Pm 3/4 | wgsl { Xm 3; },
        thing1 | Fm 1 | Pm 1/3 | wgsl { Xm 4; },
        thing1 | Fm 1/2 | wgsl {
            x = x + (sin(time) * 3.0);
            y = y + (sin(time) * 4.0);
        }
    ] 
    | Lm 2
    | Seq [AsIs, Reverse]
    | Repeat 1
    | wgsl {
        Ym 2/3;
        Vm 1/3;
        Sm 3.0;
        x = x + (sin(time) * 3.0);
        y = y + (sin(time) * 4.0);
        x = sin(y + time * 0.001) + x * 2.0;
        z = sin(y + time * 0.002) + z * 2.0;
        y = y + time * 2.0;
    }
    | Hue 0.1
    | Seq [Fm 1, Fm 9/8, Fm 5/4]
    | Overlay [
        Sine,
        Tanh(5, 0.5),
        Square | Wavefolder(0.2, 8, 2, 0.25),
        Sine 3/2 | Wavefolder(0.2, 8, 2, 0.25),
        -- Bitcrusher(8, 1, 1),
        -- Overdrive(50, 0.1),
    ]
}

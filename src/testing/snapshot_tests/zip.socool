{ f: 220, l: 1, g: 1, p: 0 }

-- Zip: isorhythm. The bracket list IS the rhythm — one step per element,
-- applied to the subject's events in turn and cycled when it runs short.
-- The subject arrives through the pipe, because Zip never changes the
-- event count; it only multiplies fields into the events already there.

-- A color of 7 pitches under a talea of 2 steps. Seven events, not
-- fourteen: the talea cycles and never extends the subject.
color = { Seq [Fm 1, Fm 9/8, Fm 5/4, Fm 4/3, Fm 3/2, Fm 5/3, Fm 15/8] }
talea = { Seq [Lm 3, Lm 2] | Lm 1/5 }

isorhythm = { color | Zip [Lm 3/5, Lm 2/5] }

-- A named talea is the same thing: `Zip [a, b]` is `Zip [Seq [a, b]]`.
named = { color | Zip [talea] }

-- Swing: the pair sums to 2, same as two straight notes, so the phrase
-- length is untouched and only the placement moves.
swing = { color | Zip [Lm 4/3, Lm 2/3] }

-- Several cycles at once is what chaining is for. Each Zip is one talea,
-- and they layer because a talea only multiplies fields into events that
-- are already there — 7 against 2 against 3.
layered = { color | Zip [Lm 3/5, Lm 2/5] | Zip [Gm 1, Gm 1/2, Gm 3/4] }

-- The phasing is opt-in and visible: repeat the subject and the accents
-- land somewhere new the second time round.
phased = { color | Repeat 2 | Zip [Lm 3/5, Lm 2/5] }

main = {
    Overlay [
        isorhythm,
        named | Tm 2 | Gm 1/2,
        swing | Tm 1/2,
        layered | Tm 1/2 | Gm 1/2,
        phased | Tm 3 | Gm 1/3,
    ]
}

{ f: 220, l: 1, g: 1, p: 0 }

-- Zip: isorhythm. Events pair up by position and multiply; the later
-- operands cycle under the first, which alone governs length.

-- A color of 7 pitches against a talea of 2 durations. Seven events, not
-- fourteen: the subject sets the length and the rhythm cycles under it.
color = { Seq [Fm 1, Fm 9/8, Fm 5/4, Fm 4/3, Fm 3/2, Fm 5/3, Fm 15/8] }
talea = { Seq [Lm 3, Lm 2] | Lm 1/5 }

-- Swing: the pair sums to 2, same as two straight notes, so the bar length
-- is untouched and only the placement moves.
swing = { Zip [color, Seq [Lm 4/3, Lm 2/3]] }

-- A third operand rides along on a cycle of its own — 7 against 2 against 3.
-- A pattern of only `Gm` has fm = 1, so it contributes nothing but gain.
dynamics = { Zip [color, talea, Seq [Gm 1, Gm 1/2, Gm 3/4]] }

-- The phasing is opt-in and visible: repeat the subject and the accents
-- land somewhere new the second time round.
phased = { Zip [color | Repeat 2, talea] }

main = {
    Overlay [
        Zip [color, talea],
        swing | Tm 2 | Gm 1/2,
        dynamics | Tm 1/2,
        phased | Tm 3 | Gm 1/3,
    ]
}

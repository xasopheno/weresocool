{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        {1/1, 2, 1, 1},
        {1/1, 0, 1, -1}
    ]
    | Choose [
        Fm 1, Fm 9/8, Fm 5/4, Fm 1/2, Fm 15/16, Fm 3/2 | Overlay [Fm 1/2, Fm 3/2, Fm 1],
        Fm 2/3 | Lm 5
    ]
    | Repeat 8
    | FitLength Lm 8
}

main = {
    Overlay [
        thing1 | Fm 2,
        thing1 | Fm 3/2,
        thing1 | Fm 1,
        thing1 | Fm 1/2
    ]
    | Lm 1/2
    | Repeat 3
}

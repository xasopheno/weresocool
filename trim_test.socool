{ f: 220, l: 1, g: 1.0, p: 0.0}

thing1 = {
    Sequence [
        AsIs,
        Fm 9/8,
        Fm 5/4,
        Fm 3/2
    ]
}

-- Test basic trim - keep first half  
test1 = {
    thing1 | Trim [Keep, Fm 0]
}

-- Test complex trim - keep middle segment
test2 = {
    thing1 | Trim [Lm 1/4, Keep, Lm 1/2, Lm 1/4]
}

-- Test trim with operations in slicer
test3 = {
    thing1 | Trim [Lm 2, thing1 | Lm 1/2, Keep, Lm 1]
}

main = {
    Seq [
        test1 | Pm -1,
        test2,
        test3 | Pm 1
    ]
    | Lm 1
}

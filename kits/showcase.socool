{ f: 60, l: 1/2, g: 1, p: 0 }

-- Preset showcase: every built-in drum preset, one hit each, in the
-- order: wsc, 808, 909, knock/trap, acoustic/brush, dust
-- (claps: wsc, 808, 909, trap, dust; rimshots: wsc, 808, 909, acoustic).
-- Render with: weresocool print kits/showcase.socool

x = { Silence 1 }

kicks = {
    Seq [
        Kick wsc, x, Kick 808, x, Kick 909, x,
        Kick knock, x, Kick acoustic, x, Kick dust, x
    ]
}

snares = {
    Seq [
        Snare wsc, x, Snare 808, x, Snare 909, x,
        Snare trap, x, Snare brush, x, Snare dust, x
    ] | Fm 3
}

hats = {
    Seq [
        HiHat wsc, x, HiHat 808, x, HiHat 909, x,
        HiHat trap, x, HiHat acoustic, x, HiHat dust, x
    ] | Fm 5
}

open_hats = {
    Seq [
        OpenHat wsc, x, OpenHat 808, x, OpenHat 909, x,
        OpenHat trap, x, OpenHat acoustic, x, OpenHat dust, x
    ] | Fm 5
}

claps = {
    Seq [
        Clap wsc, x, Clap 808, x, Clap 909, x,
        Clap trap, x, Clap dust, x
    ] | Fm 3
}

rimshots = {
    Seq [
        Rimshot wsc, x, Rimshot 808, x,
        Rimshot 909, x, Rimshot acoustic, x
    ] | Fm 3
}

-- The five drums added to the kit. Toms track the note, so this line is
-- one drum at one register; the cymbals and shaker anchor themselves
-- against the f:60 header and need no `Fm`.

toms = {
    Seq [
        Tom wsc, x, Tom 808, x, Tom 909, x,
        Tom acoustic, x, Tom conga, x, Tom dust, x
    ]
}

rides = {
    Seq [
        Ride wsc, x, Ride 909, x, Ride acoustic, x,
        Ride bell, x, Ride dark, x
    ]
}

crashes = {
    Seq [
        Crash wsc, x, Crash 909, x, Crash acoustic, x,
        Crash splash, x, Crash china, x
    ]
}

shakers = {
    Seq [
        Shaker wsc, x, Shaker tambourine, x, Shaker maraca, x,
        Shaker cabasa, x, Shaker 808, x
    ]
}

cowbells = {
    Seq [
        Cowbell wsc, x, Cowbell 808, x, Cowbell acoustic, x
    ]
}

main = {
    Seq [kicks, snares, hats, open_hats, claps, rimshots,
         toms, rides, crashes, shakers, cowbells]
}

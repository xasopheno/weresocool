{ f: 80, l: 1/4, g: 1, p: 0 }

-- Kit: Industrial
-- 909 bones pushed harder: extra saturation on the kick, trap snare with
-- the crack center dropped into its harshest register, tight bright hats.
-- Demonstrates preset + override syntax: params after the preset name
-- override that preset's values.

bd = { Kick 909 { saturation: 0.9, hump: 1.2 } | Gm 0.6 }

sn = { Snare trap { saturation: 0.7, crack_freq: 3200 } | Fm 3 | Gm 0.5 }

hh = { HiHat trap | Fm 45 | Gm 0.2 }

oh = { OpenHat 909 | Fm 45 | Gm 0.22 }

cp = { Clap 909 | Fm 3 | Gm 0.5 }

rs = { Rimshot 909 | Fm 3 | Gm 0.4 }

main = { Silence 1 }

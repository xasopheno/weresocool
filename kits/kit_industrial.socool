{ f: 80, l: 1/4, g: 1, p: 0 }

-- Kit: Industrial
-- Distorted kick, metallic snare, harsh hats
-- High saturation, aggressive transients

bd = {
    Kick {
        pitch_decay: 0.015,
        pitch_range: 1.8,
        amp_decay: 0.1,
        click_amount: 0.7,
        sub_amount: 0.2,
        harmonic_damping: 2.5,
        saturation: 0.8,
        velocity_tilt: 0.4,
        transient_curve: 2.2
    }
    | Gm 0.4
}

sn = {
    Snare {
        shell_decay: 0.05,
        wire_decay: 0.03,
        wire_mix: 0.55,
        shell_pitch_decay: 60,
        shell_pitch_range: 0.2,
        crack: 0.6,
        attack_amount: 0.5,
        saturation: 0.3,
        velocity_tilt: 0.4
    }
    | Fm 2.5
    | Gm 0.45
}

hh = {
    HiHat {
        decay_rate: 40,
        brightness: 0.7,
        pitch_drop: 0.018,
        velocity_tilt: 0.4
    }
    | Fm 90
    | Gm 0.15
}

main = { Silence 1 }

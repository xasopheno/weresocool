{ f: 80, l: 1/4, g: 1, p: 0 }

-- Kit: Industrial
-- 909 bones pushed harder: extra saturation on the kick, trap snare with
-- the crack center dropped into its harshest register, tight bright hats.
-- Demonstrates preset + override syntax: params after the preset name
-- override that preset's values.

bd = { Kick 909 { saturation: 0.9, hump: 1.2 } | Gm 0.6 }

sn = { Snare trap { saturation: 0.7, crack_freq: 3200 } | Fm 3 | Gm 0.5 }

hh = { HiHat trap | Fm 45 | Gm 0.2 }

oh = { OpenHat 909 | Fm 45 | Gm 0.22 }

cp = { Clap 909 | Fm 3 | Gm 0.5 }

rs = { Rimshot 909 | Fm 3 | Gm 0.4 }


-- ── the rest of the kit ──────────────────────────────────────────────
-- `crush` across the board — the whole kit is one word.
--
-- The toms are one voice at three registers: `Tom` tracks the played
-- note fully (pitch_track 1.0), so `Fm 2/3` and `Fm 3/2` are honest
-- intervals off the middle drum. The cymbals and shaker anchor
-- themselves against the f:60 header instead — `Fm` colours the metal
-- without transposing it off the map — so they need no `Fm` at all.

lt = { Tom crush | Fm 2/3 | Gm 0.7 }

mt = { Tom crush | Gm 0.7 }

ht = { Tom crush | Fm 3/2 | Gm 0.7 }

rd = { Ride crush | Gm 0.28 }

cr = { Crash crush | Gm 0.3 }

sh = { Shaker crush | Gm 0.3 }

cb = { Cowbell crush | Gm 0.45 }

main = { Silence 1 }

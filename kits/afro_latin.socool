{ f: 60, l: 1/12, g: 1, p: 0 }

-- Afro-Latin percussion on the new kit voices.
--   1. Bembé (12/8, Afro-Cuban): the standard 7-stroke bell pattern,
--      congas at three registers, cabasa running underneath.
--   2. Samba (2/4 in 16ths): surdo on the answer beat, agogô high/low,
--      tamborim stick pattern, maraca 16ths.
-- The header l:1/12 gives the bembé its 12-pulse bar; the samba section
-- is scaled to 16ths with | Lm 3/4 (1/12 · 3/4 = 1/16).
--
-- Play: weresocool play kits/afro_latin.socool

x = { Silence 1 }

-- congas: one drum, three registers (Tom tracks the note fully)
cl = { Tom conga | Fm 2/3 | Gm 0.85 }
cm = { Tom conga | Gm 0.75 }
ch = { Tom conga | Fm 3/2 | Gm 0.7 }

-- bells: agogô = the same cowbell at two pitches
be = { Cowbell acoustic | Gm 0.5 }
bh = { Cowbell acoustic | Fm 4/3 | Gm 0.45 }

-- shakers and sticks
sk = { Shaker cabasa | Gm 0.45 }
ma = { Shaker maraca | Gm 0.4 }
cs = { Rimshot acoustic | Fm 3 | Gm 0.55 }

-- surdo: the acoustic kick dropped an octave
su = { Kick acoustic | Fm 1/2 | Gm 0.95 }

-- ── bembé: one 12-pulse bar ─────────────────────────────────────────
-- bell strokes on pulses 1,3,5,6,8,10,12 — the classic short bell
bembe = {
    Overlay [
        Seq [be, x, be, x, be, be, x, be, x, be, x, be],
        Seq [cl, x, x, ch, x, x, cl, x, ch, x, cm, x],
        Seq [sk, sk | Gm 0.4, sk | Gm 0.4, sk, sk | Gm 0.4, sk | Gm 0.4,
             sk, sk | Gm 0.4, sk | Gm 0.4, sk, sk | Gm 0.4, sk | Gm 0.4]
    ]
}

-- ── samba: 16 sixteenths = two 2/4 bars ─────────────────────────────
samba = {
    Overlay [
        -- surdo: ghost on 1, full on 2 — the answer drum
        Seq [su | Gm 0.3, x, x, x,   su, x, x, x,
             su | Gm 0.3, x, x, x,   su, x, x, x],
        -- agogô: high leads, low answers
        Seq [bh, x, x, bh,   x, x, be, x,
             bh, x, x, be,   x, bh, be, x],
        -- tamborim-style stick pattern
        Seq [cs, x, x, cs,   x, x, cs, x,
             cs, x, x, cs,   x, x, cs, x],
        -- maraca: straight 16ths, accents on the beat
        Seq [ma, ma | Gm 0.5, ma | Gm 0.6, ma | Gm 0.5,
             ma, ma | Gm 0.5, ma | Gm 0.6, ma | Gm 0.5,
             ma, ma | Gm 0.5, ma | Gm 0.6, ma | Gm 0.5,
             ma, ma | Gm 0.5, ma | Gm 0.6, ma | Gm 0.5]
    ] | Lm 3/4
}

main = {
    Seq [
        bembe, bembe, bembe, bembe,
        samba, samba, samba, samba
    ]
}

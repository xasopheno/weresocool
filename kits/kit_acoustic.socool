{ f: 80, l: 1/4, g: 1, p: 0 }

-- Kit: Acoustic
-- Waveguide-dominant kick with wooden shell ring, head-dominant brushy
-- snare, loose live hats with modal beating. Organic, played feel —
-- velocity (Gm on individual hits) changes timbre strongly on this kit.

bd = { Kick acoustic | Gm 0.6 }

sn = { Snare brush | Fm 3 | Gm 0.55 }

hh = { HiHat acoustic | Fm 40 | Gm 0.25 }

oh = { OpenHat acoustic | Fm 40 | Gm 0.28 }

cp = { Clap wsc | Fm 3 | Gm 0.5 }

rs = { Rimshot acoustic | Fm 3 | Gm 0.4 }


-- ── the rest of the kit ──────────────────────────────────────────────
-- A played kit: struck heads, a ride with a real bell, a maraca
-- rather than a machine shaker.
--
-- The toms are one voice at three registers: `Tom` tracks the played
-- note fully (pitch_track 1.0), so `Fm 2/3` and `Fm 3/2` are honest
-- intervals off the middle drum. The cymbals and shaker anchor
-- themselves against the f:60 header instead — `Fm` colours the metal
-- without transposing it off the map — so they need no `Fm` at all.

lt = { Tom acoustic | Fm 2/3 | Gm 0.72 }

mt = { Tom acoustic | Gm 0.72 }

ht = { Tom acoustic | Fm 3/2 | Gm 0.72 }

rd = { Ride acoustic | Gm 0.32 }

cr = { Crash acoustic | Gm 0.34 }

sh = { Shaker maraca | Gm 0.34 }

cb = { Cowbell acoustic | Gm 0.42 }

main = { Silence 1 }

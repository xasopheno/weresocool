{ f: 60, l: 1/16, g: 1, p: 0 }

-- ════════════════════════════════════════════════════════════════════
-- FIVE CHARACTER DRUMSETS — demo  (v2: pushed into distinct spaces)
--
-- Same four-bar groove with each drumset, so you can A/B the character.
-- These are deliberately ORTHOGONAL — each one changes *which synthesis
-- components dominate*, not just the EQ:
--
--   glass   bright crystalline tonal RING — pitched modes, noise≈0   (bell)
--   doom    deep dark cavernous BOOM — sub-tuned, very long, dark
--   crush   distorted bit-crushed INDUSTRIAL — saturation/drive maxed
--   air     soft breathy WASH — broadband noise only, NO transient
--   snap    ultra-tight dry CLICK — transient only, NO tail
--
-- air and snap are opposites (all-tail vs all-transient); so are
-- glass and doom (bright vs dark). Every drum family has all five, so a
-- whole kit is one word: `Kick crush`, `Snare crush`, …
--
-- Render: weresocool print kits/new_drumsets.socool
-- ════════════════════════════════════════════════════════════════════

x = { Silence 1 }

-- One bar (16 sixteenths) of a groove that exercises the whole kit.
groove(bd, sn, hh, oh, cp, rs) = {
    Overlay [
        Seq [
            bd, x, x, x, x, x, bd | Gm 0.55, x, x, x, bd, x, x, x, bd | Gm 0.5, x
        ],
        Seq [
            x, x, x, x, sn, x, x, sn | Gm 0.2, x, x, x, x, sn, x, sn | Gm 0.22, sn | Gm 0.5
        ],
        Seq [
            hh | Gm 0.5, x, hh | Gm 0.3, x, hh | Gm 0.5, x, hh | Gm 0.3, x,
            hh | Gm 0.5, x, hh | Gm 0.3, x, hh | Gm 0.5, x, oh | Gm 0.4, x
        ],
        Seq [
            x, x, x, x, x, x, x, x, x, x, rs | Pa 1/4 | Gm 0.4, x, x, cp | Gm 0.3, x, x
        ]
    ]
}

glass_kit = {
    groove(Kick glass, Snare glass, HiHat glass, OpenHat glass, Clap glass, Rimshot glass)
    | Lm 1 | Repeat 4
}

doom_kit = {
    groove(Kick doom, Snare doom, HiHat doom, OpenHat doom, Clap doom, Rimshot doom)
    | Lm 1 | Repeat 4
}

crush_kit = {
    groove(Kick crush, Snare crush, HiHat crush, OpenHat crush, Clap crush, Rimshot crush)
    | Lm 1 | Repeat 4
}

air_kit = {
    groove(Kick air, Snare air, HiHat air, OpenHat air, Clap air, Rimshot air)
    | Lm 1 | Repeat 4
}

snap_kit = {
    groove(Kick snap, Snare snap, HiHat snap, OpenHat snap, Clap snap, Rimshot snap)
    | Lm 1 | Repeat 4
}

gap = { Silence 1 | Lm 8 }

main = {
    Seq [
        glass_kit, gap,
        doom_kit,  gap,
        crush_kit, gap,
        air_kit,   gap,
        snap_kit
    ]
}

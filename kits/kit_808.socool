{ f: 60, l: 1/4, g: 1, p: 0 }

-- Kit: TR-808
-- Long sub-boom kick, tight dark snare, metallic square-bank hats.
-- The header f:60 sets the kick fundamental. The snare and hi-hat
-- multiply it up (Fm 3, Fm 50) to land in their respective registers.
-- All drums respond to standard language ops:
--   bd | Fm 1/2   -> octave-down sub kick
--   bd | Lm 2     -> doubled note length
-- The Gm values are MIX staging (presets are loudness-balanced at the
-- engine level — switching presets never changes the balance).

bd = { Kick 808 | Gm 0.6 }

sn = { Snare 808 | Fm 3 | Gm 0.5 }

hh = { HiHat 808 | Fm 50 | Gm 0.22 }

oh = { OpenHat 808 | Fm 50 | Gm 0.25 }

cp = { Clap 808 | Fm 3 | Gm 0.5 }

rs = { Rimshot 808 | Fm 3 | Gm 0.4 }


-- ── the rest of the kit ──────────────────────────────────────────────
-- The 808 has no ride or crash of its own — its cymbal is one
-- short metallic voice — so those two take the signature `wsc`.
--
-- The toms are one voice at three registers: `Tom` tracks the played
-- note fully (pitch_track 1.0), so `Fm 2/3` and `Fm 3/2` are honest
-- intervals off the middle drum. The cymbals and shaker anchor
-- themselves against the f:60 header instead — `Fm` colours the metal
-- without transposing it off the map — so they need no `Fm` at all.

lt = { Tom 808 | Fm 2/3 | Gm 0.7 }

mt = { Tom 808 | Gm 0.7 }

ht = { Tom 808 | Fm 3/2 | Gm 0.7 }

rd = { Ride wsc | Gm 0.28 }

cr = { Crash wsc | Gm 0.3 }

sh = { Shaker 808 | Gm 0.32 }

cb = { Cowbell 808 | Gm 0.5 }

main = { Silence 1 }

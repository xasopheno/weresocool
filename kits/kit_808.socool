{ f: 60, l: 1/4, g: 1, p: 0 }

-- Kit: TR-808
-- Long sub-boom kick, tight dark snare, metallic square-bank hats.
-- The header f:60 sets the kick fundamental. The snare and hi-hat
-- multiply it up (Fm 3, Fm 50) to land in their respective registers.
-- All drums respond to standard language ops:
--   bd | Fm 1/2   -> octave-down sub kick
--   bd | Lm 2     -> doubled note length
-- The Gm values are MIX staging (presets are loudness-balanced at the
-- engine level — switching presets never changes the balance).

bd = { Kick 808 | Gm 0.6 }

sn = { Snare 808 | Fm 3 | Gm 0.5 }

hh = { HiHat 808 | Fm 50 | Gm 0.22 }

oh = { OpenHat 808 | Fm 50 | Gm 0.25 }

cp = { Clap 808 | Fm 3 | Gm 0.5 }

rs = { Rimshot 808 | Fm 3 | Gm 0.4 }

main = { Silence 1 }

{ f: 80, l: 1/4, g: 1, p: 0 }

-- Kit: Minimal
-- Soft kick, muted snare, delicate hats
-- Low saturation, gentle attacks

bd = {
    Kick {
        pitch_decay: 0.04,
        pitch_range: 1.5,
        amp_decay: 0.2,
        click_amount: 0.15,
        sub_amount: 0.05,
        harmonic_damping: 1.0,
        saturation: 0.1,
        velocity_tilt: 0.9,
        transient_curve: 0.8
    }
    | Gm 0.38
}

sn = {
    Snare {
        shell_decay: 0.07,
        wire_decay: 0.05,
        wire_mix: 0.35,
        shell_pitch_decay: 25,
        shell_pitch_range: 0.2,
        crack: 0.4,
        attack_amount: 0.25,
        saturation: 0.08,
        velocity_tilt: 0.85
    }
    | Fm 2
    | Gm 0.5
}

hh = {
    HiHat {
        decay_rate: 50,
        brightness: 0.4,
        pitch_drop: 0.005,
        velocity_tilt: 0.75
    }
    | Fm 50
    | Gm 0.15
}

main = { Silence 1 }

{ f: 440, l: 1/4, g: 1, p: 0 }

kick = { Kick { punch: 3/4, body: 1.5, air: 1/2 } }

ghost_kick = { Kick { punch: 1/4, body: 1/2 } | Gm 1/2 }

big_kick = { Kick { punch: 1, body: 1, air: 1/4 } }

snare = { Seq [Fm 0 | Lm 1/4, Snare { punch: 3/4, body: 1/2, air: 3/4, dynamics: 3/4 }] }

ghost_snare = { Seq [Fm 0 | Lm 1/4, Snare { punch: 1/4, body: 1/2, air: 1/2 } | Gm 1/3] }

hat = { HiHat { punch: 1/2, body: 1/4, air: 1/2 } | Gm 2/3 }

hat_accent = { HiHat { punch: 3/4, body: 1/3, air: 3/4 } }

open_hat = { OpenHat { punch: 1/2, body: 3/4, air: 2/3 } | Gm 3/4 }

x = { Silence 1 }

s = { Lm 1/4 }

kick_pattern = {
    Seq [
        kick | s, x | s, x | s, x | s,
        x | s, x | s, ghost_kick | s, x | s,
        kick | s, x | s, x | s, kick | s,
        x | s, ghost_kick | s, x | s, x | s
    ]
    | Color [red, orange, yellow, green]
    | wgsl {
        Direction(-1, 1, 0)
    }
}

snare_pattern = {
    Seq [
        x | s, x | s, x | s, ghost_snare | s,
        snare | s, x | s, x | s, x | s,
        x | s, ghost_snare | s, x | s, x | s,
        snare | s, x | s, x | s, x | s
    ]
    | Color [blue, indigo, violet, purple]
    | wgsl {
        Direction(1, 1, 0)
    }
}

hat_pattern = {
    Seq [
        hat_accent | s, hat | s, hat | s, hat | s,
        hat | s, hat | s, hat | s, hat | s,
        hat_accent | s, hat | s, hat | s, hat | s,
        hat | s, hat | s, open_hat | s, x | s
    ]
    | Color [cyan, lightblue, skyblue, steelblue]
    | wgsl {
        Direction(0, -1, 0)
    }
}

bar = {
    Overlay [
        kick_pattern,
        snare_pattern,
        hat_pattern
    ]
    | wgsl {
        Xm "sin(time * 2.0) * 0.5"
    }
}

fill_bar = {
    Overlay [
        Seq [
            big_kick | s, x | s, x | s, x | s,
            x | s, x | s, kick | s, x | s,
            big_kick | s, x | s, kick | s, x | s,
            big_kick | s, kick | s, big_kick | s, big_kick | s
        ],
        Seq [
            x | s, x | s, x | s, x | s,
            snare | s, x | s, ghost_snare | s, ghost_snare | s,
            snare | s, ghost_snare | s, snare | s, ghost_snare | s,
            snare | s, snare | s, snare | s, snare | Gm 5/4 | s
        ],
        hat_pattern
    ]
    | Color [white, lightgray, gray]
    | wgsl {
        Direction(0, 0, -1)
    }
}

drums = {
    Seq [
        bar,
        bar,
        bar,
        fill_bar
    ]
    | Repeat 2
}

chords = {
    Overlay [
        { 3/2, 3, 1, 1/5 },
        { 3/2, 0, 1, -1/5 },
        { 1, 0.2, 1, 1/6 },
        { 1, 3, 1, 1/6 },
        { 3/4, 3, 1, 1/5 },
        { 3/4, 0, 1, -1/5 },
        { 1/2, 0.2, 1, 1/6 },
        { 1/2, 0, 1, -1/6 },
        { 1/4, 3, 1, 1/6 },
        { 1/4, 0, 1, -1/6 },
    ]
    | Seq [
        Fm 0, Fm 1, Fm 0, Fa -5,
    ]
    -- | Repeat 2
    | Seq [
        Fm 0, Fm 1 | Lm 2, Fm 9/8, Fm 0, Fm 3/4, Fm 2/3, Fm 5/8, Fm 7/12 | Lm 1/8,
    ]
    | Overlay [
        Sine 3/2 | Gm 1/4,
        Square | Gm 1/4,
        Sine,
    ]
    | Repeat 8
    | FitLength drums
    | wgsl {
        Direction(0, 0, -1);
    }
}

main = {
    Overlay [
        drums,
        chords
        | Color [midnightblue, purple, deeppink, orange, yellow]
    ]
    | Lm 3.1
    | wgsl {
        Direction(0, 0, -1);
        Xm 3;
    }
}
